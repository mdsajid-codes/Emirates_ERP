        {
            "name": "2. Create Customer with Payment GL Accounts",
            "item": [
                {
                    "name": "Create Customer with All Payment Accounts",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 201\", function () {",
                                    "    pm.response.to.have.status(201);",
                                    "});",
                                    "",
                                    "pm.test(\"Response has payment GL accounts\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.glAccounts).to.not.be.null;",
                                    "    pm.expect(jsonData.glAccounts.cashAccountId).to.not.be.null;",
                                    "    pm.expect(jsonData.glAccounts.bankAccountId).to.not.be.null;",
                                    "    pm.expect(jsonData.glAccounts.chequeAccountId).to.not.be.null;",
                                    "});",
                                    "",
                                    "// Save company ID for later tests",
                                    "var jsonData = pm.response.json();",
                                    "pm.environment.set(\"customerId\", jsonData.companyId);"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"code\": \"CUST-PAY-001\",\n  \"name\": \"Test Customer with Payment Accounts\",\n  \"fullDescription\": \"Customer for testing payment GL accounts\",\n  \"companyType\": \"CUSTOMER\",\n  \"taxId\": \"TAX123456\",\n  \"legalAddress\": \"123 Main St\",\n  \"deliveryAddress\": \"123 Main St\",\n  \"contactPerson\": \"John Doe\",\n  \"bankAccount\": \"ACC-123456\",\n  \"isVATTaxpayer\": true,\n  \"pricesIncludeVAT\": false,\n  \"glAccounts\": {\n    \"accountsReceivableId\": 1,\n    \"cashAccountId\": 2,\n    \"bankAccountId\": 3,\n    \"chequeAccountId\": 4\n  }\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/accounts/companies",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "accounts",
                                "companies"
                            ]
                        }
                    },
                    "response": []
                },
