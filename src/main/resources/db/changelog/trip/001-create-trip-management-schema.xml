        </createTable>
        <addForeignKeyConstraint baseTableName="trip_payment" baseColumnNames="trip_id" referencedTableName="trips" referencedColumnNames="id" constraintName="fk_trip_payment_trip"/>
    </changeSet>

    <!-- 7. Trip Vendor Assignment -->
    <changeSet id="trip-001-trip-vendor-assignment" author="system">
        <validCheckSum>ANY</validCheckSum>
        <validCheckSum>9:547d4d0166bff9bd6b46176e143604ff</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="trip_vendor_assignment"/></not>
        </preConditions>
        <createTable tableName="trip_vendor_assignment">
            <column name="id" type="BIGINT" autoIncrement="true">
