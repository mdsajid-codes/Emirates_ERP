{
    "databaseChangeLog": [
        {
            "changeSet": {
                "id": "001-create-master-tenant-table",
                "author": "sajid",
                "preConditions": [
                    {
                        "onFail": "MARK_RAN",
                        "not": {
                            "tableExists": {
                                "tableName": "master_tenant"
                            }
                        }
                    }
                ],
                "changes": [
                    {
                        "createTable": {
                            "tableName": "master_tenant",
                            "columns": [
                                {
                                    "column": {
                                        "name": "id",
                                        "type": "BIGINT",
                                        "autoIncrement": true,
                                        "constraints": {
                                            "primaryKey": true,
                                            "nullable": false
                                        }
                                    }
                                },
                                {
                                    "column": {
                                        "name": "tenant_id",
                                        "type": "VARCHAR(255)",
                                        "constraints": {
                                            "nullable": false,
                                            "unique": true
                                        }
                                    }
                                },
                                {
                                    "column": {
                                        "name": "company_name",
                                        "type": "VARCHAR(255)",
                                        "constraints": {
                                            "nullable": false
                                        }
                                    }
                                },
                                {
                                    "column": {
                                        "name": "jdbc_url",
                                        "type": "VARCHAR(255)",
                                        "constraints": {
                                            "nullable": false
                                        }
                                    }
                                },
                                {
                                    "column": {
                                        "name": "username",
                                        "type": "VARCHAR(255)",
                                        "constraints": {
                                            "nullable": false
                                        }
                                    }
                                },
                                {
                                    "column": {
                                        "name": "password",
                                        "type": "VARCHAR(255)",
                                        "constraints": {
                                            "nullable": false
                                        }
                                    }
                                },
                                {
                                    "column": {
                                        "name": "service_modules",
                                        "type": "json"
                                    }
                                },
                                {
                                    "column": {
                                        "name": "number_of_locations",
                                        "type": "INT"
                                    }
                                },
                                {
                                    "column": {
                                        "name": "number_of_users",
                                        "type": "INT"
                                    }
                                },
                                {
                                    "column": {
                                        "name": "number_of_store",
                                        "type": "INT"
                                    }
                                },
                                {
                                    "column": {
                                        "name": "hrms_access_count",
                                        "type": "INT"
                                    }
                                },
                                {
                                    "column": {
                                        "name": "subscription_start_date",
                                        "type": "DATE"
                                    }
                                },
                                {
                                    "column": {
                                        "name": "subscription_end_date",
                                        "type": "DATE"
                                    }
                                },
                                {
                                    "column": {
                                        "name": "status",
                                        "type": "VARCHAR(50)"
                                    }
                                }
                            ]
                        }
                    }
                ]
            }
        }
    ]
}