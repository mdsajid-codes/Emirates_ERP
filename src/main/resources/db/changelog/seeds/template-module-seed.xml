<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- TEMPLATE: Copy and modify for new module seed data -->
    <changeSet id="YYYYMMDD-module-name-seed-default-data" author="emirates-erp">
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="your_target_table"/>
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM your_target_table</sqlCheck>
        </preConditions>
        <insert tableName="your_target_table">
            <column name="code" value="DEFAULT_001"/>
            <column name="name" value="Default Item"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="created_at" valueDate="NOW()"/>
            <column name="updated_at" valueDate="NOW()"/>
        </insert>
    </changeSet>

</databaseChangeLog>
