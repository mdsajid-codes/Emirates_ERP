<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-sales-invoices-notes-schema" author="system">
        <validCheckSum>ANY</validCheckSum>

        <!-- sales_invoices -->
        <createTable tableName="sales_invoices">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="tenant_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="invoice_ledger" type="VARCHAR(255)"/>
            <column name="invoice_date" type="DATE"/>
            <column name="customer_id" type="BIGINT"/>
            <column name="number" type="VARCHAR(255)"><constraints unique="true"/></column>
            <column name="customer_po_no" type="VARCHAR(255)"/>
            <column name="customer_po_date" type="DATE"/>
            <column name="order_number" type="VARCHAR(255)"/>
            <column name="reference" type="VARCHAR(255)"/>
            <column name="due_date" type="DATE"/>
            <column name="date_of_supply" type="DATE"/>
            <column name="salesperson_id" type="BIGINT"/>
            <column name="sale_type" type="VARCHAR(50)"/>
            <column name="enable_gross_net_weight" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="delay_reason" type="VARCHAR(255)"/>
            <column name="sub_total" type="DECIMAL(19, 4)"/>
            <column name="total_discount" type="DECIMAL(19, 4)"/>
            <column name="gross_total" type="DECIMAL(19, 4)"/>
            <column name="total_tax" type="DECIMAL(19, 4)"/>
            <column name="other_charges" type="DECIMAL(19, 4)"/>
            <column name="net_total" type="DECIMAL(19, 4)"/>
            <column name="amount_received" type="DECIMAL(19, 4)"/>
            <column name="balance_due" type="DECIMAL(19, 4)"/>
            <column name="status" type="VARCHAR(50)"/>
            <column name="terms_and_conditions" type="TEXT"/>
            <column name="notes" type="TEXT"/>
            <column name="template" type="VARCHAR(255)"/>
            <column name="email_to" type="VARCHAR(255)"/>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="updated_by" type="VARCHAR(255)"/>
            <column name="updated_at" type="DATETIME"/>
            <column name="created_at" type="DATETIME"/>
        </createTable>

        <!-- sales_invoice_items -->
        <createTable tableName="sales_invoice_items">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="sales_invoice_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="crm_product_id" type="BIGINT"/>
            <column name="item_code" type="VARCHAR(255)"/>
            <column name="item_name" type="VARCHAR(255)"/>
            <column name="category_id" type="BIGINT"/>
            <column name="subcategory_id" type="BIGINT"/>
            <column name="description" type="VARCHAR(2000)"/>
            <column name="packing_type" type="VARCHAR(100)"/>
            <column name="quantity_gross" type="DECIMAL(19, 4)"/>
            <column name="quantity_net" type="DECIMAL(19, 4)"/>
            <column name="send_quantity" type="DECIMAL(19, 4)"/>
            <column name="invoice_quantity" type="DECIMAL(19, 4)"/>
            <column name="rate" type="DECIMAL(19, 4)"/>
            <column name="amount" type="DECIMAL(19, 4)"/>
            <column name="tax_value" type="DECIMAL(19, 4)"/>
            <column name="is_tax_exempt" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="tax_percentage" type="DECIMAL(19, 4)"/>
            <column name="raw_material_id" type="BIGINT"/>
            <column name="semifinished_id" type="BIGINT"/>
            <column name="finished_good_id" type="BIGINT"/>
        </createTable>

        <!-- sales_invoice_attachments -->
        <createTable tableName="sales_invoice_attachments">
            <column name="sales_invoice_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="attachment_url" type="VARCHAR(1024)"/>
        </createTable>

        <!-- credit_notes -->
        <createTable tableName="credit_notes">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="tenant_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="location_id" type="BIGINT"/>
            <column name="customer_id" type="BIGINT"/>
            <column name="credit_note_number" type="VARCHAR(255)"/>
            <column name="invoice_number" type="VARCHAR(255)"/>
            <column name="credit_note_date" type="DATE"/>
            <column name="amount" type="DECIMAL(19, 4)"/>
            <column name="tax_percentage" type="DECIMAL(19, 4)"/>
            <column name="terms_and_conditions" type="TEXT"/>
            <column name="notes" type="TEXT"/>
            <column name="template" type="VARCHAR(255)"/>
            <column name="email_to" type="VARCHAR(255)"/>
            <column name="status" type="VARCHAR(50)"/>
            <column name="balance_due" type="DECIMAL(19, 4)"/>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="updated_by" type="VARCHAR(255)"/>
            <column name="created_at" type="DATETIME"/>
            <column name="updated_at" type="DATETIME"/>
        </createTable>

        <!-- credit_note_attachments -->
        <createTable tableName="credit_note_attachments">
            <column name="credit_note_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="attachment_url" type="VARCHAR(1024)"/>
        </createTable>

        <!-- recieved_amounts -->
        <createTable tableName="recieved_amounts">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="tenant_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="entry_type" type="VARCHAR(100)"/>
            <column name="location_id" type="BIGINT"/>
            <column name="customer_id" type="BIGINT"/>
            <column name="pi_number" type="VARCHAR(255)"/>
            <column name="manual_pi_number" type="VARCHAR(255)"/>
            <column name="amount" type="DECIMAL(19, 4)"/>
            <column name="received_full_amount" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="tax_deducted" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="deposit_date" type="DATE"/>
            <column name="deposit_mode" type="VARCHAR(100)"/>
            <column name="reference" type="VARCHAR(255)"/>
            <column name="cheque_number" type="VARCHAR(100)"/>
            <column name="receiving_date" type="DATE"/>
            <column name="received_number" type="VARCHAR(255)"/>
            <column name="invoice_number" type="VARCHAR(255)"/>
            <column name="tds" type="DECIMAL(19, 4)"/>
            <column name="advance_amount" type="DECIMAL(19, 4)"/>
            <column name="total_pi_amount" type="DECIMAL(19, 4)"/>
            <column name="fbc" type="DECIMAL(19, 4)"/>
            <column name="expected_in_fc" type="DECIMAL(19, 4)"/>
            <column name="bank_charges" type="DECIMAL(19, 4)"/>
            <column name="fine_and_penalty" type="DECIMAL(19, 4)"/>
            <column name="rebate_and_discount" type="DECIMAL(19, 4)"/>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="updated_by" type="VARCHAR(255)"/>
            <column name="created_at" type="DATETIME"/>
            <column name="updated_at" type="DATETIME"/>
        </createTable>

    </changeSet>

</databaseChangeLog>
