<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-sal-additional-expense-tables-1" author="system">
        <validCheckSum>ANY</validCheckSum>
        
        <!-- sal_additional_expense -->
        <createTable tableName="sal_additional_expense">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="number" type="VARCHAR(100)"><constraints unique="true"/></column>
            <column name="date" type="DATE"><constraints nullable="false"/></column>
            <column name="company_id" type="BIGINT"/>
            <column name="contract" type="VARCHAR(255)"/>
            <column name="transaction_type" type="VARCHAR(50)"/>
            <column name="sales_order_id" type="BIGINT"/>
            <column name="currency" type="VARCHAR(10)"/>
            <column name="exchange_rate" type="DECIMAL(19, 6)" defaultValueNumeric="1"/>
            <column name="comment" type="TEXT"/>
            <column name="status" type="VARCHAR(50)"/>
            <column name="tenant_id" type="BIGINT"/>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="created_at" type="DATETIME"/>
            <column name="total_amount" type="DECIMAL(19, 4)" defaultValueNumeric="0"/>
        </createTable>

        <!-- sal_additional_expense_line -->
        <createTable tableName="sal_additional_expense_line">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="additional_expense_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="product_id" type="BIGINT"/>
            <column name="unit_id" type="BIGINT"/>
            <column name="amount" type="DECIMAL(19, 4)" defaultValueNumeric="0"/>
            <column name="tax_id" type="BIGINT"/>
            <column name="tax_amount" type="DECIMAL(19, 4)" defaultValueNumeric="0"/>
            <column name="total_amount" type="DECIMAL(19, 4)" defaultValueNumeric="0"/>
        </createTable>

        <!-- sal_additional_expense_inventory -->
        <createTable tableName="sal_additional_expense_inventory">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="additional_expense_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="document_type" type="VARCHAR(100)"/>
            <column name="document_id" type="VARCHAR(100)"/>
            <column name="product_id" type="BIGINT"/>
            <column name="batch" type="VARCHAR(100)"/>
            <column name="quantity" type="DECIMAL(19, 6)" defaultValueNumeric="1"/>
            <column name="unit_id" type="BIGINT"/>
            <column name="price" type="DECIMAL(19, 4)" defaultValueNumeric="0"/>
            <column name="amount" type="DECIMAL(19, 4)" defaultValueNumeric="0"/>
            <column name="factor" type="DECIMAL(19, 6)" defaultValueNumeric="1"/>
            <column name="expense_amount" type="DECIMAL(19, 4)" defaultValueNumeric="0"/>
        </createTable>

        <addForeignKeyConstraint baseColumnNames="additional_expense_id" baseTableName="sal_additional_expense_line" constraintName="fk_sal_ae_line_ae" referencedColumnNames="id" referencedTableName="sal_additional_expense" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseColumnNames="additional_expense_id" baseTableName="sal_additional_expense_inventory" constraintName="fk_sal_ae_inv_ae" referencedColumnNames="id" referencedTableName="sal_additional_expense" onDelete="CASCADE"/>

    </changeSet>

</databaseChangeLog>
