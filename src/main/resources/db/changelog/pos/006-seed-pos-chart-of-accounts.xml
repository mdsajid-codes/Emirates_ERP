    <changeSet id="006-seed-pos-chart-of-accounts" author="dev-a">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="chart_of_accounts"/>
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM chart_of_accounts WHERE account_code = 'POS-1010'
            </sqlCheck>
        </preConditions>

        <insert tableName="chart_of_accounts">
            <column name="account_code" value="POS-1010"/>
            <column name="description" value="POS Cash in Till"/>
            <column name="account_type" value="DEBIT"/>
            <column name="section" value="BS_CASH"/>
            <column name="is_quantitative" valueBoolean="false"/>
            <column name="is_off_balance" valueBoolean="false"/>
            <column name="level" valueNumeric="3"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="currency" value="AED"/>
            <column name="tenant_id" valueComputed="(SELECT id FROM tenants LIMIT 1)"/>
            <column name="parent_id" valueComputed="(SELECT account_id FROM (SELECT account_id, account_code FROM chart_of_accounts) AS t WHERE t.account_code = '2050000' LIMIT 1)"/>
        </insert>

