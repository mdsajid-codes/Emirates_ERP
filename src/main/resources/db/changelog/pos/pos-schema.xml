<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-pos-schema-1" author="system">
        <validCheckSum>ANY</validCheckSum>
        
        <!-- audit_events -->
        <createTable tableName="audit_events">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="tenant_id" type="BIGINT"/>
            <column name="actor_id" type="BIGINT"/>
            <column name="entity_type" type="VARCHAR(255)"/>
            <column name="entity_id" type="BIGINT"/>
            <column name="action" type="VARCHAR(255)"/>
            <column name="payload" type="TEXT"/>
            <column name="created_at" type="DATETIME"/>
        </createTable>

        <!-- billing_invoices -->
        <createTable tableName="billing_invoices">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="tenant_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="invoice_no" type="VARCHAR(255)"/>
            <column name="amount_cents" type="BIGINT"/>
            <column name="paid" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="issued_at" type="DATETIME"/>
            <column name="due_at" type="DATETIME"/>
            <column name="paid_at" type="DATETIME"/>
            <column name="provider_invoice_id" type="VARCHAR(255)"/>
            <column name="created_at" type="DATETIME"/>
        </createTable>

        <!-- cash_registers -->
        <createTable tableName="cash_registers">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="tenant_id" type="BIGINT"/>
            <column name="opening_time" type="DATETIME"/>
            <column name="closing_time" type="DATETIME"/>
            <column name="opening_float" type="DECIMAL(19, 2)"/>
            <column name="expected_cash_amount" type="DECIMAL(19, 2)"/>
            <column name="counted_cash_amount" type="DECIMAL(19, 2)"/>
            <column name="closed_cash_difference" type="DECIMAL(19, 2)"/>
            <column name="notes" type="VARCHAR(255)"/>
            <column name="status" type="VARCHAR(50)"/>
        </createTable>

        <!-- categories -->
        <createTable tableName="categories">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="tenant_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="name" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="description" type="TEXT"/>
            <column name="created_at" type="DATETIME"/>
        </createTable>

        <!-- customers -->
        <createTable tableName="customers">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="tenant_id" type="BIGINT"/>
            <column name="name" type="VARCHAR(255)"/>
            <column name="phone" type="VARCHAR(50)"/>
            <column name="email" type="VARCHAR(255)"/>
            <column name="loyalty_points" type="BIGINT" defaultValueNumeric="0"/>
            <column name="created_at" type="DATETIME"/>
        </createTable>

        <!-- tax_rates -->
        <createTable tableName="tax_rates">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="tenant_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="name" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="percent" type="DECIMAL(5, 2)"><constraints nullable="false"/></column>
            <column name="compound" type="BOOLEAN" defaultValueBoolean="false"/>
        </createTable>

        <!-- products -->
        <createTable tableName="products">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="tenant_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="category_id" type="BIGINT"/>
            <column name="sku" type="VARCHAR(255)"/>
            <column name="name" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="description" type="TEXT"/>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="created_at" type="DATETIME"/>
        </createTable>

        <!-- product_variants -->
        <createTable tableName="product_variants">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="product_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="tax_rate_id" type="BIGINT"/>
            <column name="sku" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="barcode" type="VARCHAR(255)"/>
            <column name="attributes" type="JSON"/>
            <column name="price_cents" type="BIGINT"/>
            <column name="cost_cents" type="BIGINT"/>
            <column name="image_url" type="VARCHAR(255)"/>
            <column name="barcode_image_url" type="VARCHAR(255)"/>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="created_at" type="DATETIME"/>
            <column name="updated_at" type="DATETIME"/>
        </createTable>

        <!-- inventory -->
        <createTable tableName="inventory">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="store_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="product_variant_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="quantity" type="BIGINT" defaultValueNumeric="0"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="inventory" columnNames="store_id, product_variant_id" constraintName="uk_inv_store_variant"/>

        <!-- sales -->
        <createTable tableName="sales">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="tenant_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="store_id" type="BIGINT"/>
            <column name="user_id" type="BIGINT"/>
            <column name="customer_id" type="BIGINT"/>
            <column name="driver_id" type="BIGINT"/>
            <column name="order_id" type="VARCHAR(255)"><constraints nullable="false" unique="true"/></column>
            <column name="invoice_no" type="VARCHAR(255)"><constraints nullable="false" unique="true"/></column>
            <column name="invoice_date" type="DATETIME"/>
            <column name="subtotal_cents" type="BIGINT"/>
            <column name="tax_cents" type="BIGINT"/>
            <column name="discount_cents" type="BIGINT" defaultValueNumeric="0"/>
            <column name="discount_type" type="VARCHAR(255)"/>
            <column name="discount_reason" type="TEXT"/>
            <column name="cancellation_reason" type="TEXT"/>
            <column name="cancelled_time" type="DATETIME"/>
            <column name="delivery_charge" type="BIGINT"/>
            <column name="total_cents" type="BIGINT"/>
            <column name="status" type="VARCHAR(255)" defaultValue="completed"><constraints nullable="false"/></column>
            <column name="payment_status" type="VARCHAR(255)" defaultValue="unpaid"><constraints nullable="false"/></column>
            <column name="order_type" type="VARCHAR(50)"/>
            <column name="adults_count" type="INT"/>
            <column name="kids_count" type="INT"/>
            <column name="sales_source" type="VARCHAR(255)"/>
            <column name="sales_source_reference" type="VARCHAR(255)"/>
            <column name="car_number" type="VARCHAR(255)"/>
            <column name="car_color" type="VARCHAR(255)"/>
            <column name="delivered_time" type="DATETIME"/>
            <column name="delivery_address" type="VARCHAR(255)"/>
            <column name="dispatched_time" type="DATETIME"/>
            <column name="expected_delivery_time" type="DATETIME"/>
            <column name="created_at" type="DATETIME"/>
        </createTable>

        <!-- sale_items -->
        <createTable tableName="sale_items">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="sale_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="product_variant_id" type="BIGINT"/>
            <column name="cost_cents" type="BIGINT"/>
            <column name="quantity" type="BIGINT"/>
            <column name="unit_price_cents" type="BIGINT"/>
            <column name="line_total_cents" type="BIGINT"/>
            <column name="tax_cents" type="BIGINT"/>
            <column name="discount_cents" type="BIGINT" defaultValueNumeric="0"/>
        </createTable>

        <!-- payments -->
        <createTable tableName="payments">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="sale_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="method" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="amount_cents" type="BIGINT"><constraints nullable="false"/></column>
            <column name="reference" type="VARCHAR(255)"/>
            <column name="created_at" type="DATETIME"/>
        </createTable>

        <!-- payment_change_logs -->
        <createTable tableName="payment_change_logs">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="tenant_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="store_id" type="BIGINT"/>
            <column name="sale_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="payment_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="user_id" type="BIGINT"/>
            <column name="card_assigned_user" type="VARCHAR(255)"/>
            <column name="from_method" type="VARCHAR(255)"/>
            <column name="to_method" type="VARCHAR(255)"/>
            <column name="change_reason" type="VARCHAR(255)"/>
            <column name="created_at" type="DATETIME"/>
        </createTable>

        <!-- plans -->
        <createTable tableName="plans">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="code" type="VARCHAR(255)"><constraints nullable="false" unique="true"/></column>
            <column name="name" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="description" type="TEXT"/>
            <column name="price_cents" type="BIGINT"><constraints nullable="false"/></column>
            <column name="currency" type="VARCHAR(3)" defaultValue="AED"/>
            <column name="billing_interval" type="VARCHAR(255)" defaultValue="MONTH"><constraints nullable="false"/></column>
            <column name="trial_days" type="INT" defaultValueNumeric="0"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="created_at" type="DATETIME"/>
        </createTable>

        <!-- plan_features -->
        <createTable tableName="plan_features">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="plan_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="feature_key" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="value" type="BIGINT"/>
            <column name="meta" type="VARCHAR(255)"/>
        </createTable>
        <addUniqueConstraint tableName="plan_features" columnNames="plan_id, feature_key" constraintName="uk_plan_feature"/>

        <!-- tenant_subscriptions -->
        <createTable tableName="tenant_subscriptions">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="tenant_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="plan_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="status" type="VARCHAR(255)" defaultValue="active"><constraints nullable="false"/></column>
            <column name="started_at" type="DATETIME"/>
            <column name="current_period_start" type="DATETIME"/>
            <column name="current_period_end" type="DATETIME"/>
            <column name="next_billing_at" type="DATETIME"/>
            <column name="quantity" type="BIGINT" defaultValueNumeric="1"/>
            <column name="provider_subscription_id" type="VARCHAR(255)"/>
            <column name="cancel_at_period_end" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="created_at" type="DATETIME"/>
        </createTable>

        <!-- usage_records -->
        <createTable tableName="usage_records">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="tenant_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="feature_key" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="period_start" type="DATETIME"/>
            <column name="period_end" type="DATETIME"/>
            <column name="amount" type="BIGINT"/>
            <column name="created_at" type="DATETIME"/>
        </createTable>
        <!-- Adding index for usage_records -->
        <createIndex tableName="usage_records" indexName="idx_usage_tenant_feature_period">
            <column name="tenant_id"/>
            <column name="feature_key"/>
            <column name="period_start"/>
        </createIndex>

        <!-- purchase_orders -->
        <createTable tableName="purchase_orders">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="tenant_id" type="BIGINT"/>
            <column name="store_id" type="BIGINT"/>
            <column name="po_number" type="VARCHAR(255)"/>
            <column name="supplier_name" type="VARCHAR(255)"/>
            <column name="status" type="VARCHAR(255)" defaultValue="open"/>
            <column name="created_at" type="DATETIME"/>
        </createTable>

        <!-- purchase_order_items -->
        <createTable tableName="purchase_order_items">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="purchase_order_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="product_variant_id" type="BIGINT"/>
            <column name="quantity_ordered" type="BIGINT"/>
            <column name="quantity_received" type="BIGINT" defaultValueNumeric="0"/>
            <column name="unit_cost_cents" type="BIGINT"/>
        </createTable>

        <!-- stock_movements -->
        <createTable tableName="stock_movements">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="tenant_id" type="BIGINT"/>
            <column name="store_id" type="BIGINT"/>
            <column name="product_variant_id" type="BIGINT"/>
            <column name="related_sale_id" type="BIGINT"/>
            <column name="related_purchase_id" type="BIGINT"/>
            <column name="change_quantity" type="BIGINT"/>
            <column name="reason" type="VARCHAR(255)"/>
            <column name="batch_code" type="VARCHAR(255)"/>
            <column name="expire_date" type="DATETIME"/>
            <column name="created_at" type="DATETIME"/>
        </createTable>

        <!-- sales_forecasts -->
        <createTable tableName="sales_forecasts">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="tenant_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="store_id" type="BIGINT"/>
            <column name="month" type="DATE"><constraints nullable="false"/></column>
            <column name="forecast_amount" type="DECIMAL(19, 2)"><constraints nullable="false"/></column>
            <column name="created_at" type="DATETIME"/>
            <column name="updated_at" type="DATETIME"/>
        </createTable>
        <addUniqueConstraint tableName="sales_forecasts" columnNames="tenant_id, store_id, month" constraintName="uk_sales_forecast"/>

        <!-- Foreign Keys (optional but good practice) -->
        <!-- Just basic FKs for standard relationships -->
        <addForeignKeyConstraint baseTableName="products" baseColumnNames="tenant_id" constraintName="fk_pos_prod_tenant" referencedTableName="tenants" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="categories" baseColumnNames="tenant_id" constraintName="fk_pos_cat_tenant" referencedTableName="tenants" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="sales" baseColumnNames="tenant_id" constraintName="fk_pos_sale_tenant" referencedTableName="tenants" referencedColumnNames="id"/>

    </changeSet>
</databaseChangeLog>
