<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="pos-002-add-journal-link-to-sales" author="emirates_erp">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="sales"/>
            <tableExists tableName="journal_entries"/>
        </preConditions>
        <addColumn tableName="sales">
            <column name="journal_entry_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>
            <column name="cogs_journal_entry_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
