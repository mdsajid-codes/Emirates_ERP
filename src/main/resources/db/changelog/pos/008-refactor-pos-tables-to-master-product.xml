<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        v3 changesets: Removed <validCheckSum>ANY</validCheckSum> which, when combined with
        <preConditions>, causes a Liquibase 4.31.1 scope-tracking bug (Cannot end scope X
        when currently at scope Y). New IDs (v3) ensure these run fresh; preConditions with
        onFail=MARK_RAN handle cases where changes were already applied by v2.
    -->

    <!-- 1. Add product_id to inventory -->
    <changeSet id="008-add-product-id-to-inventory-v3" author="antigravity">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="inventory"/>
            <not>
                <columnExists tableName="inventory" columnName="product_id"/>
            </not>
        </preConditions>
        <addColumn tableName="inventory">
            <column name="product_id" type="BIGINT">
                <constraints foreignKeyName="fk_inventory_master_product" referencedTableName="crm_sales_products" referencedColumnNames="id"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- 2. Drop old FK fk_inventory_variant if exists -->
    <changeSet id="008-drop-fk-inventory-variant-v3" author="antigravity">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="inventory"/>
            <foreignKeyConstraintExists foreignKeyTableName="inventory" foreignKeyName="fk_inventory_variant"/>
        </preConditions>
        <dropForeignKeyConstraint baseTableName="inventory" constraintName="fk_inventory_variant"/>
    </changeSet>

    <!-- 3. Drop product_variant_id from inventory if exists -->
    <changeSet id="008-drop-product-variant-id-from-inventory-v3" author="antigravity">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="inventory"/>
            <columnExists tableName="inventory" columnName="product_variant_id"/>
        </preConditions>
        <dropColumn tableName="inventory" columnName="product_variant_id"/>
    </changeSet>

