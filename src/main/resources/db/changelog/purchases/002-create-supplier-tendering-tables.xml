<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-supplier-tendering-tables" author="system">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="pur_supplier_tendering"/></not>
        </preConditions>
        
        <!-- pur_supplier_tendering -->
        <createTable tableName="pur_supplier_tendering">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="tender_number" type="VARCHAR(100)"><constraints unique="true"/></column>
            <column name="status" type="VARCHAR(50)"/>
            <column name="transaction_type" type="VARCHAR(100)"/>
            <column name="initiated_by" type="VARCHAR(100)"/>
            <column name="required_date" type="DATE"/>
            <column name="project" type="VARCHAR(200)"/>
            <column name="entity_name" type="VARCHAR(200)"/>
            <column name="tendering_currency" type="VARCHAR(10)"/>
            <column name="basis_type" type="VARCHAR(50)"/>
            <column name="basis_id" type="BIGINT"/>
            <column name="warehouse_id" type="BIGINT"/>
            <column name="tenant_id" type="BIGINT"/>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="created_at" type="DATETIME"/>
        </createTable>

        <!-- pur_supplier_tendering_item -->
        <createTable tableName="pur_supplier_tendering_item">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="tendering_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="line_number" type="INT"/>
            <column name="item_id" type="BIGINT"/>
            <column name="item_name" type="VARCHAR(255)"/>
            <column name="content" type="VARCHAR(1000)"/>
            <column name="quantity" type="DECIMAL(19, 4)"/>
            <column name="uom" type="VARCHAR(50)"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="pur_supplier_tendering_item" baseColumnNames="tendering_id" referencedTableName="pur_supplier_tendering" referencedColumnNames="id" constraintName="fk_pur_sti_tendering"/>

        <!-- pur_supplier_tendering_question -->
        <createTable tableName="pur_supplier_tendering_question">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="tendering_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="question_id" type="BIGINT"/>
            <column name="question_text" type="VARCHAR(1000)"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="pur_supplier_tendering_question" baseColumnNames="tendering_id" referencedTableName="pur_supplier_tendering" referencedColumnNames="id" constraintName="fk_pur_stq_tendering"/>

        <!-- pur_supplier_tendering_supplier -->
        <createTable tableName="pur_supplier_tendering_supplier">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="tendering_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="supplier_id" type="BIGINT"/>
            <column name="supplier_name" type="VARCHAR(255)"/>
            <column name="contract_type" type="VARCHAR(100)"/>
            <column name="contact_person" type="VARCHAR(255)"/>
            <column name="email" type="VARCHAR(255)"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="pur_supplier_tendering_supplier" baseColumnNames="tendering_id" referencedTableName="pur_supplier_tendering" referencedColumnNames="id" constraintName="fk_pur_sts_tendering"/>

        <!-- pur_supplier_tendering_supplier_item -->
        <createTable tableName="pur_supplier_tendering_supplier_item">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="tendering_supplier_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="tendering_item_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="selected" type="BOOLEAN"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="pur_supplier_tendering_supplier_item" baseColumnNames="tendering_supplier_id" referencedTableName="pur_supplier_tendering_supplier" referencedColumnNames="id" constraintName="fk_pur_stsi_supplier"/>
        <addForeignKeyConstraint baseTableName="pur_supplier_tendering_supplier_item" baseColumnNames="tendering_item_id" referencedTableName="pur_supplier_tendering_item" referencedColumnNames="id" constraintName="fk_pur_stsi_item"/>
    </changeSet>

    <changeSet id="fix-missing-tendering-id-v2" author="system">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="pur_supplier_tendering_item"/>
            <not><columnExists tableName="pur_supplier_tendering_item" columnName="tendering_id"/></not>
        </preConditions>
        <addColumn tableName="pur_supplier_tendering_item">
            <column name="tendering_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <addForeignKeyConstraint baseTableName="pur_supplier_tendering_item" baseColumnNames="tendering_id" referencedTableName="pur_supplier_tendering" referencedColumnNames="id" constraintName="fk_pur_sti_tendering_v2"/>
    </changeSet>

</databaseChangeLog>
