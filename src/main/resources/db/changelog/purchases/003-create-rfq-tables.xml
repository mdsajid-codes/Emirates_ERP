<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-rfq-tables" author="system">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="pur_request_for_quotation"/></not>
        </preConditions>

        <!-- pur_rfq_question -->
        <createTable tableName="pur_rfq_question">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="question_text" type="VARCHAR(1000)"/>
            <column name="tenant_id" type="BIGINT"/>
        </createTable>

        <!-- pur_request_for_quotation -->
        <createTable tableName="pur_request_for_quotation">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="rfq_number" type="VARCHAR(100)"><constraints unique="true"/></column>
            <column name="tendering_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="supplier_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="sent_date" type="DATETIME"/>
            <column name="online_form_url" type="VARCHAR(500)"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="pur_request_for_quotation" baseColumnNames="tendering_id" referencedTableName="pur_supplier_tendering" referencedColumnNames="id" constraintName="fk_pur_rfq_tendering"/>
        <addForeignKeyConstraint baseTableName="pur_request_for_quotation" baseColumnNames="supplier_id" referencedTableName="pur_supplier_tendering_supplier" referencedColumnNames="id" constraintName="fk_pur_rfq_supplier"/>

        <!-- pur_request_for_quotation_item -->
        <createTable tableName="pur_request_for_quotation_item">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="rfq_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="tendering_item_id" type="BIGINT"/>
            <column name="item_id" type="BIGINT"/>
            <column name="item_name" type="VARCHAR(255)"/>
            <column name="quantity" type="DECIMAL(19, 4)"/>
            <column name="uom" type="VARCHAR(50)"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="pur_request_for_quotation_item" baseColumnNames="rfq_id" referencedTableName="pur_request_for_quotation" referencedColumnNames="id" constraintName="fk_pur_rfqi_rfq"/>

        <!-- pur_rfq_response -->
        <createTable tableName="pur_rfq_response">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="response_number" type="VARCHAR(100)"><constraints unique="true"/></column>
            <column name="rfq_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="valid_till" type="DATETIME"/>
            <column name="submitted_at" type="DATETIME"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="pur_rfq_response" baseColumnNames="rfq_id" referencedTableName="pur_request_for_quotation" referencedColumnNames="id" constraintName="fk_pur_rfqr_rfq"/>

        <!-- pur_rfq_response_item -->
        <createTable tableName="pur_rfq_response_item">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="response_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="tendering_item_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="price" type="DECIMAL(19, 4)"/>
            <column name="comment" type="VARCHAR(1000)"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="pur_rfq_response_item" baseColumnNames="response_id" referencedTableName="pur_rfq_response" referencedColumnNames="id" constraintName="fk_pur_rfqri_response"/>
        <addForeignKeyConstraint baseTableName="pur_rfq_response_item" baseColumnNames="tendering_item_id" referencedTableName="pur_supplier_tendering_item" referencedColumnNames="id" constraintName="fk_pur_rfqri_item"/>

        <!-- pur_rfq_response_answer -->
        <createTable tableName="pur_rfq_response_answer">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="response_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="question_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="answer" type="VARCHAR(2000)"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="pur_rfq_response_answer" baseColumnNames="response_id" referencedTableName="pur_rfq_response" referencedColumnNames="id" constraintName="fk_pur_rfqra_response"/>
        <addForeignKeyConstraint baseTableName="pur_rfq_response_answer" baseColumnNames="question_id" referencedTableName="pur_supplier_tendering_question" referencedColumnNames="id" constraintName="fk_pur_rfqra_question"/>
    </changeSet>

</databaseChangeLog>
