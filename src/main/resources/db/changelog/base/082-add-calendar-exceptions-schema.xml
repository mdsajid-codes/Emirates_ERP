<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="add-region-code-to-holiday-policy" author="system">
        <validCheckSum>ANY</validCheckSum>
        <addColumn tableName="holiday_policies">
            <column name="region_code" type="VARCHAR(10)"/>
        </addColumn>
    </changeSet>

    <changeSet id="create-work-calendar-exceptions-schema" author="system">
        <validCheckSum>ANY</validCheckSum>
        <createTable tableName="work_calendar_exceptions">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="holiday_policy_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="exception_date" type="DATE"><constraints nullable="false"/></column>
            <column name="is_working_day" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="reason" type="VARCHAR(255)"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="work_calendar_exceptions" baseColumnNames="holiday_policy_id"
                                 constraintName="fk_work_cal_exc_policy"
                                 referencedTableName="holiday_policies" referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>
