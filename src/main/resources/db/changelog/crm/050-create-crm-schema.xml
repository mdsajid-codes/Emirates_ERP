        <addForeignKeyConstraint baseTableName="crm_events" baseColumnNames="lead_id" referencedTableName="crm_leads" referencedColumnNames="id" constraintName="fk_crm_event_lead"/>
        <addForeignKeyConstraint baseTableName="crm_events" baseColumnNames="primary_contact_id" referencedTableName="crm_contacts" referencedColumnNames="id" constraintName="fk_crm_event_contact"/>
    </changeSet>

     <changeSet id="create-crm-event-employees" author="sajid">
