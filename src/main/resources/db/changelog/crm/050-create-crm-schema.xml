    <!-- Others: Call Logs, Todos -->
    <changeSet id="create-crm-call-logs" author="sajid">
        <validCheckSum>ANY</validCheckSum>
        <createTable tableName="crm_call_logs">
            <column name="id" type="BIGINT" autoIncrement="true">
