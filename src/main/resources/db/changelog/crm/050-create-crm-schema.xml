        </createTable>
        <addPrimaryKey tableName="crm_task_contacts" columnNames="task_id, contact_id"/>
        <addForeignKeyConstraint baseTableName="crm_task_contacts" baseColumnNames="task_id" referencedTableName="crm_tasks" referencedColumnNames="id" constraintName="fk_ctc_task"/>
        <addForeignKeyConstraint baseTableName="crm_task_contacts" baseColumnNames="contact_id" referencedTableName="crm_contacts" referencedColumnNames="id" constraintName="fk_ctc_contact"/>
    </changeSet>

    <changeSet id="create-crm-events" author="sajid">
        <validCheckSum>ANY</validCheckSum>
        <createTable tableName="crm_events">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="subject" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="same_start_end" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="event_date" type="DATE">
