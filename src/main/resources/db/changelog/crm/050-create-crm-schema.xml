            <column name="lead_id" type="BIGINT"/>
            <column name="contact_id" type="BIGINT"/>
            <column name="comments" type="TEXT"/>
            <column name="call_date" type="DATE"/>
            <column name="call_time" type="TIME"/>
            <column name="remind_me_before" type="BOOLEAN"/>
