<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- =================================================================================== -->
    <!-- Dictionaries / Lookup Tables -->
    <!-- =================================================================================== -->

    <changeSet id="create-crm-lead-sources" author="sajid">
        <validCheckSum>ANY</validCheckSum>
        <createTable tableName="crm_lead_sources">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="crm_lead_sources" columnNames="tenant_id, name" constraintName="uk_lead_source_tenant_name"/>
    </changeSet>

    <changeSet id="create-crm-lead-stages" author="sajid">
        <validCheckSum>ANY</validCheckSum>
        <createTable tableName="crm_lead_stages">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="location_id" type="BIGINT"/>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="sort_order" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="is_default" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="is_converted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="is_won" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="is_mql" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="is_sql" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="probability" type="DOUBLE"/>
            <column name="assign_to" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="move_to" type="VARCHAR(50)"/>
        </createTable>
        <addUniqueConstraint tableName="crm_lead_stages" columnNames="tenant_id, name" constraintName="uk_lead_stage_tenant_name"/>
    </changeSet>



    <changeSet id="create-company-types" author="sajid">
        <validCheckSum>ANY</validCheckSum>
        <createTable tableName="company_types">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="location_id" type="BIGINT"/>
            <column name="name" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="company_types" columnNames="tenant_id, name" constraintName="uk_company_type_tenant_name"/>
    </changeSet>

    <!-- =================================================================================== -->
    <!-- Core CRM Entities -->
    <!-- =================================================================================== -->

    <changeSet id="create-crm-companies" author="sajid">
        <validCheckSum>ANY</validCheckSum>
        <createTable tableName="crm_companies">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="location_id" type="BIGINT"/>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="company_type_id" type="BIGINT"/>
            <column name="industry_id" type="BIGINT"/>
            <column name="phone" type="VARCHAR(255)"/>
            <column name="email" type="VARCHAR(255)"/>
            <column name="website" type="VARCHAR(255)"/>
            <column name="company_owner" type="VARCHAR(255)"/>
            <column name="parent_company_id" type="BIGINT"/>
            
            <!-- Billing -->
            <column name="billing_street" type="VARCHAR(255)"/>
            <column name="billing_city" type="VARCHAR(255)"/>
            <column name="billing_zip" type="VARCHAR(255)"/>
            <column name="billing_state" type="VARCHAR(255)"/>
            <column name="billing_country" type="VARCHAR(255)"/>

            <!-- Shipping -->
            <column name="shipping_street" type="VARCHAR(255)"/>
            <column name="shipping_city" type="VARCHAR(255)"/>
            <column name="shipping_zip" type="VARCHAR(255)"/>
            <column name="shipping_state" type="VARCHAR(255)"/>
            <column name="shipping_country" type="VARCHAR(255)"/>

            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="crm_companies" columnNames="tenant_id, name" constraintName="uk_company_tenant_name"/>
        <addForeignKeyConstraint baseTableName="crm_companies" baseColumnNames="parent_company_id" referencedTableName="crm_companies" referencedColumnNames="id" constraintName="fk_company_parent"/>
    </changeSet>



    <changeSet id="create-crm-contacts" author="sajid">
        <validCheckSum>ANY</validCheckSum>
        <createTable tableName="crm_contacts">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <!-- Lead ID FK added later since leads created after? No, leads usually created first, checking loop -->
            <!-- Contact can exist without lead? The Entity says optional lead_id. -->
            <!-- But Lead refers to Contact sometimes? Lead refers to names. -->
            <column name="lead_id" type="BIGINT"/>
            
            <column name="first_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="last_name" type="VARCHAR(255)"/>
            <column name="email" type="VARCHAR(255)">
                <constraints unique="true"/>
            </column>
            <column name="phone" type="VARCHAR(255)"/>
            <column name="created_at" type="DATETIME"/>
            <column name="updated_at" type="DATETIME"/>
        </createTable>
    </changeSet>

    <!-- =================================================================================== -->
    <!-- Main Entity: CrmLead -->
    <!-- =================================================================================== -->

    <changeSet id="create-crm-leads" author="sajid">
        <validCheckSum>ANY</validCheckSum>
        <createTable tableName="crm_leads">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="location_id" type="BIGINT"/>
            <column name="lead_no" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="company_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="industry_id" type="BIGINT"/>
            
            <column name="first_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="last_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="designation" type="VARCHAR(255)"/>
            <column name="phone" type="VARCHAR(255)"/>
            <column name="email" type="VARCHAR(255)"/>
            <column name="website" type="VARCHAR(255)"/>
            
            <column name="requirements" type="VARCHAR(4000)"/>
            <column name="lead_source_id" type="BIGINT"/>
            
            <!-- Address Embedded -->
            <column name="street" type="VARCHAR(255)"/>
            <column name="city" type="VARCHAR(255)"/>
            <column name="state" type="VARCHAR(255)"/>
            <column name="zip_code" type="VARCHAR(255)"/>
            <column name="country" type="VARCHAR(255)"/>

            <column name="notes" type="VARCHAR(4000)"/>
            <column name="owner_id" type="BIGINT"/>
            <column name="current_stage_id" type="BIGINT"/>
            <column name="status" type="VARCHAR(50)"/>
            
            <column name="forecast_category" type="VARCHAR(30)"/>
            <column name="expected_close_date" type="DATE"/>
            <column name="amount" type="DECIMAL(18, 2)"/>

            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="crm_leads" indexName="idx_lead_tenant_created">
            <column name="tenant_id"/>
            <column name="created_at"/>
        </createIndex>
        <createIndex tableName="crm_leads" indexName="idx_lead_tenant_company">
            <column name="tenant_id"/>
            <column name="company_id"/>
        </createIndex>

        <addForeignKeyConstraint baseTableName="crm_leads" baseColumnNames="company_id" referencedTableName="crm_companies" referencedColumnNames="id" constraintName="fk_lead_company"/>
        <addForeignKeyConstraint baseTableName="crm_leads" baseColumnNames="industry_id" referencedTableName="crm_industries" referencedColumnNames="id" constraintName="fk_lead_industry"/>
        <addForeignKeyConstraint baseTableName="crm_leads" baseColumnNames="lead_source_id" referencedTableName="crm_lead_sources" referencedColumnNames="id" constraintName="fk_lead_source"/>
        <addForeignKeyConstraint baseTableName="crm_leads" baseColumnNames="current_stage_id" referencedTableName="crm_lead_stages" referencedColumnNames="id" constraintName="fk_lead_stage"/>
        
        <!-- Add FK to Contact NOW that Leads exists -->
        <addForeignKeyConstraint baseTableName="crm_contacts" baseColumnNames="lead_id" referencedTableName="crm_leads" referencedColumnNames="id" constraintName="fk_contact_lead"/>
    </changeSet>

    <changeSet id="create-crm-lead-products" author="sajid">
        <validCheckSum>ANY</validCheckSum>
        <createTable tableName="crm_lead_products">
            <column name="lead_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="product_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="crm_lead_products" columnNames="lead_id, product_id"/>
        <addForeignKeyConstraint baseTableName="crm_lead_products" baseColumnNames="lead_id" referencedTableName="crm_leads" referencedColumnNames="id" constraintName="fk_clp_lead"/>
        <addForeignKeyConstraint baseTableName="crm_lead_products" baseColumnNames="product_id" referencedTableName="crm_products" referencedColumnNames="id" constraintName="fk_clp_product"/>
    </changeSet>

    <!-- =================================================================================== -->
    <!-- Activities -->
    <!-- =================================================================================== -->

    <changeSet id="create-crm-tasks" author="sajid">
        <validCheckSum>ANY</validCheckSum>
        <createTable tableName="crm_tasks">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="subject" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="comments" type="TEXT"/>
            <column name="due_date" type="DATE"/>
            <column name="call_time" type="TIME"/>
            <column name="lead_id" type="BIGINT"/>
            <column name="assigned_to_id" type="BIGINT"/>
            <column name="status" type="VARCHAR(30)"/>
            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="crm_tasks" indexName="idx_crm_tasks_tenant">
            <column name="tenant_id"/>
        </createIndex>
        <addForeignKeyConstraint baseTableName="crm_tasks" baseColumnNames="lead_id" referencedTableName="crm_leads" referencedColumnNames="id" constraintName="fk_crm_task_lead"/>
    </changeSet>

    <changeSet id="create-crm-task-employees" author="sajid">
        <validCheckSum>ANY</validCheckSum>
        <createTable tableName="crm_task_employees">
            <column name="task_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="employee_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="crm_task_employees" columnNames="task_id, employee_id"/>
        <addForeignKeyConstraint baseTableName="crm_task_employees" baseColumnNames="task_id" referencedTableName="crm_tasks" referencedColumnNames="id" constraintName="fk_cte_task"/>
    </changeSet>

    <changeSet id="create-crm-task-contacts" author="sajid">
        <validCheckSum>ANY</validCheckSum>
        <createTable tableName="crm_task_contacts">
            <column name="task_id" type="BIGINT">
