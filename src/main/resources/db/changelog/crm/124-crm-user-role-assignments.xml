<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="124-create-crm-user-role-assignments" author="antigravity">
        <validCheckSum>ANY</validCheckSum>
        <createTable tableName="crm_user_role_assignments">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="employee_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="role_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="assigned_at" type="DATETIME"/>
        </createTable>

        <addUniqueConstraint tableName="crm_user_role_assignments"
                             columnNames="tenant_id, employee_id"
                             constraintName="uk_user_crm_role"/>

        <addForeignKeyConstraint baseTableName="crm_user_role_assignments"
                                 baseColumnNames="role_id"
                                 referencedTableName="roles"
                                 referencedColumnNames="id"
                                 constraintName="fk_ura_role"/>
    </changeSet>

</databaseChangeLog>
