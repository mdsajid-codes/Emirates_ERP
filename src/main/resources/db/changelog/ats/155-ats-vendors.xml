<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-ats-vendor-tables" author="sajid">
        <validCheckSum>ANY</validCheckSum>

        <!-- 0. Lookup: ats_business_units -->
        <createTable tableName="ats_business_units">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(50)"/>
            <column name="description" type="VARCHAR(500)"/>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="ats_business_units" indexName="idx_ats_bu_tenant_name">
            <column name="tenant_id"/>
            <column name="name"/>
        </createIndex>
        <createIndex tableName="ats_business_units" indexName="idx_ats_bu_tenant_active">
            <column name="tenant_id"/>
            <column name="is_active"/>
        </createIndex>

        <addForeignKeyConstraint baseTableName="ats_business_units" baseColumnNames="tenant_id" referencedTableName="tenants" referencedColumnNames="id" constraintName="fk_ats_bu_tenant"/>

        <!-- 0b. Lookup: ats_actions -->
        <createTable tableName="ats_actions">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(300)"/>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="ats_actions" indexName="idx_ats_action_tenant_name">
            <column name="tenant_id"/>
            <column name="name"/>
        </createIndex>
        <createIndex tableName="ats_actions" indexName="idx_ats_action_tenant_active">
            <column name="tenant_id"/>
            <column name="is_active"/>
        </createIndex>

        <addForeignKeyConstraint baseTableName="ats_actions" baseColumnNames="tenant_id" referencedTableName="tenants" referencedColumnNames="id" constraintName="fk_ats_action_tenant"/>

        <!-- 1. Root: ats_vendors -->
        <createTable tableName="ats_vendors">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="vendor_code" type="VARCHAR(50)"/>
            <column name="company_name" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="display_name" type="VARCHAR(200)"/>
            <column name="vendor_type" type="VARCHAR(50)"/>
            <column name="vendor_status" type="VARCHAR(50)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
            <column name="is_blacklisted" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="blacklist_reason" type="VARCHAR(1000)"/>
            <column name="website" type="VARCHAR(500)"/>
            <column name="primary_email" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="alternate_email" type="VARCHAR(150)"/>
            <column name="primary_phone" type="VARCHAR(30)"/>
            <column name="fax_number" type="VARCHAR(30)"/>
            <column name="tax_id" type="VARCHAR(255)"/>
            <column name="primary_business_unit_id" type="BIGINT"/>
            <column name="vendor_visibility" type="VARCHAR(50)"/>
            <column name="federal_id" type="VARCHAR(100)"/>
            <column name="send_requirement" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="send_hotlist" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="ownership" type="VARCHAR(200)"/>
            <column name="allow_access_to_all_users" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="vendor_lead_id" type="BIGINT"/>
            <column name="technologies" type="VARCHAR(1000)"/>
            <column name="about_vendor" type="VARCHAR(4000)"/>
            <column name="address" type="VARCHAR(500)"/>
            <column name="city" type="VARCHAR(100)"/>
            <column name="state_id" type="BIGINT"/>
            <column name="zip_code" type="VARCHAR(20)"/>
            <column name="country_id" type="BIGINT"/>
            <column name="notes" type="VARCHAR(4000)"/>
            <column name="owner_id" type="BIGINT"/>
            <column name="created_by_id" type="BIGINT"/>
            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="ats_vendors" indexName="idx_ats_vendor_tenant_status">
            <column name="tenant_id"/>
            <column name="vendor_status"/>
        </createIndex>
        <createIndex tableName="ats_vendors" indexName="idx_ats_vendor_tenant_email">
            <column name="tenant_id"/>
            <column name="primary_email"/>
        </createIndex>
        <createIndex tableName="ats_vendors" indexName="idx_ats_vendor_tenant_created">
            <column name="tenant_id"/>
            <column name="created_at"/>
        </createIndex>

        <addForeignKeyConstraint baseTableName="ats_vendors" baseColumnNames="tenant_id" referencedTableName="tenants" referencedColumnNames="id" constraintName="fk_ats_vendor_tenant"/>
        <addForeignKeyConstraint baseTableName="ats_vendors" baseColumnNames="owner_id" referencedTableName="employees" referencedColumnNames="id" constraintName="fk_ats_vendor_owner"/>
        <addForeignKeyConstraint baseTableName="ats_vendors" baseColumnNames="created_by_id" referencedTableName="employees" referencedColumnNames="id" constraintName="fk_ats_vendor_created_by"/>
        <addForeignKeyConstraint baseTableName="ats_vendors" baseColumnNames="vendor_lead_id" referencedTableName="employees" referencedColumnNames="id" constraintName="fk_ats_vendor_lead"/>
        <addForeignKeyConstraint baseTableName="ats_vendors" baseColumnNames="state_id" referencedTableName="ats_states" referencedColumnNames="id" constraintName="fk_ats_vendor_state"/>
        <addForeignKeyConstraint baseTableName="ats_vendors" baseColumnNames="country_id" referencedTableName="ats_countries" referencedColumnNames="id" constraintName="fk_ats_vendor_country"/>


        <!-- 2. ats_vendor_contacts -->
        <createTable tableName="ats_vendor_contacts">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="vendor_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="is_primary" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="salutation" type="VARCHAR(20)"/>
            <column name="first_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="last_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(150)"/>
            <column name="designation" type="VARCHAR(150)"/>
            <column name="email" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="phone" type="VARCHAR(30)"/>
            <column name="phone_extension" type="VARCHAR(10)"/>
            <column name="mobile" type="VARCHAR(30)"/>
            <column name="address_1" type="VARCHAR(250)"/>
            <column name="address_2" type="VARCHAR(250)"/>
            <column name="country_id" type="BIGINT"/>
            <column name="state_id" type="BIGINT"/>
            <column name="city" type="VARCHAR(100)"/>
            <column name="zip_code" type="VARCHAR(20)"/>
            <column name="linkedin_url" type="VARCHAR(500)"/>
            <column name="facebook_url" type="VARCHAR(500)"/>
            <column name="twitter_url" type="VARCHAR(500)"/>
            <column name="google_plus_url" type="VARCHAR(500)"/>
            <column name="status" type="VARCHAR(50)"/>
            <column name="technologies" type="VARCHAR(1000)"/>
            <column name="owner_id" type="BIGINT"/>
            <column name="allow_access_to_all_users" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="comment" type="VARCHAR(2000)"/>
            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="ats_vendor_contacts" baseColumnNames="tenant_id" referencedTableName="tenants" referencedColumnNames="id" constraintName="fk_ats_vendor_contact_tenant"/>
        <addForeignKeyConstraint baseTableName="ats_vendor_contacts" baseColumnNames="vendor_id" referencedTableName="ats_vendors" referencedColumnNames="id" constraintName="fk_ats_vendor_contact_vendor"/>
        <addForeignKeyConstraint baseTableName="ats_vendor_contacts" baseColumnNames="country_id" referencedTableName="ats_countries" referencedColumnNames="id" constraintName="fk_ats_vendor_contact_country"/>
        <addForeignKeyConstraint baseTableName="ats_vendor_contacts" baseColumnNames="state_id" referencedTableName="ats_states" referencedColumnNames="id" constraintName="fk_ats_vendor_contact_state"/>
        <addForeignKeyConstraint baseTableName="ats_vendor_contacts" baseColumnNames="owner_id" referencedTableName="employees" referencedColumnNames="id" constraintName="fk_ats_vendor_contact_owner"/>


        <!-- 3. ats_vendor_contracts -->
        <createTable tableName="ats_vendor_contracts">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="vendor_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="contract_number" type="VARCHAR(100)"/>
            <column name="contract_type" type="VARCHAR(50)"/>
            <column name="contract_status" type="VARCHAR(50)" defaultValue="DRAFT">
                <constraints nullable="false"/>
            </column>
            <column name="start_date" type="DATE"/>
            <column name="end_date" type="DATE"/>
            <column name="signed_date" type="DATE"/>
            <column name="payment_terms" type="VARCHAR(500)"/>
            <column name="bill_rate" type="DECIMAL(15,2)"/>
            <column name="pay_rate" type="DECIMAL(15,2)"/>
            <column name="currency" type="VARCHAR(10)"/>
            <column name="markup_percent" type="DECIMAL(5,2)"/>
            <column name="auto_renew" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="document_url" type="VARCHAR(500)"/>
            <column name="snapshot" type="TEXT"/>
            <column name="contract_notes" type="VARCHAR(4000)"/>
            <column name="created_by_id" type="BIGINT"/>
            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="ats_vendor_contracts" baseColumnNames="tenant_id" referencedTableName="tenants" referencedColumnNames="id" constraintName="fk_ats_vendor_contract_tenant"/>
        <addForeignKeyConstraint baseTableName="ats_vendor_contracts" baseColumnNames="vendor_id" referencedTableName="ats_vendors" referencedColumnNames="id" constraintName="fk_ats_vendor_contract_vendor"/>
        <addForeignKeyConstraint baseTableName="ats_vendor_contracts" baseColumnNames="created_by_id" referencedTableName="employees" referencedColumnNames="id" constraintName="fk_ats_vendor_contract_created_by"/>


        <!-- 4. ats_vendor_notes -->
        <createTable tableName="ats_vendor_notes">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="vendor_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="note_title" type="VARCHAR(300)">
                <constraints nullable="false"/>
            </column>
            <column name="note_body" type="TEXT"/>
            <column name="action_id" type="BIGINT"/>
            <column name="notes_priority" type="VARCHAR(50)"/>
            <column name="note_header" type="VARCHAR(500)"/>
            <column name="remind_me" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="is_pinned" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="created_by_id" type="BIGINT"/>
            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="ats_vendor_notes" baseColumnNames="tenant_id" referencedTableName="tenants" referencedColumnNames="id" constraintName="fk_ats_vendor_note_tenant"/>
        <addForeignKeyConstraint baseTableName="ats_vendor_notes" baseColumnNames="vendor_id" referencedTableName="ats_vendors" referencedColumnNames="id" constraintName="fk_ats_vendor_note_vendor"/>
        <addForeignKeyConstraint baseTableName="ats_vendor_notes" baseColumnNames="created_by_id" referencedTableName="employees" referencedColumnNames="id" constraintName="fk_ats_vendor_note_created_by"/>
        <addForeignKeyConstraint baseTableName="ats_vendor_notes" baseColumnNames="action_id" referencedTableName="ats_actions" referencedColumnNames="id" constraintName="fk_ats_vendor_note_action"/>

        <!-- Many-To-Many Join Table: ats_vendor_note_notifications -->
        <createTable tableName="ats_vendor_note_notifications">
            <column name="note_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="employee_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="ats_vendor_note_notifications" columnNames="note_id, employee_id" constraintName="pk_ats_vendor_note_notif"/>
        <addForeignKeyConstraint baseTableName="ats_vendor_note_notifications" baseColumnNames="note_id" referencedTableName="ats_vendor_notes" referencedColumnNames="id" constraintName="fk_ats_vn_notification_note"/>
        <addForeignKeyConstraint baseTableName="ats_vendor_note_notifications" baseColumnNames="employee_id" referencedTableName="employees" referencedColumnNames="id" constraintName="fk_ats_vn_notification_emp"/>


        <!-- 5. ats_vendor_tasks -->
        <createTable tableName="ats_vendor_tasks">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="vendor_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="task_title" type="VARCHAR(300)">
                <constraints nullable="false"/>
            </column>
            <column name="task_description" type="VARCHAR(2000)"/>
            <column name="task_status" type="VARCHAR(50)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="priority" type="VARCHAR(50)" defaultValue="MEDIUM">
                <constraints nullable="false"/>
            </column>
            <column name="due_date" type="DATE"/>
            <column name="assigned_to_id" type="BIGINT"/>
            <column name="completed_at" type="DATETIME"/>
            <column name="created_by_id" type="BIGINT"/>
            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="ats_vendor_tasks" baseColumnNames="tenant_id" referencedTableName="tenants" referencedColumnNames="id" constraintName="fk_ats_vendor_task_tenant"/>
        <addForeignKeyConstraint baseTableName="ats_vendor_tasks" baseColumnNames="vendor_id" referencedTableName="ats_vendors" referencedColumnNames="id" constraintName="fk_ats_vendor_task_vendor"/>
        <addForeignKeyConstraint baseTableName="ats_vendor_tasks" baseColumnNames="assigned_to_id" referencedTableName="employees" referencedColumnNames="id" constraintName="fk_ats_vendor_task_assigned_to"/>
        <addForeignKeyConstraint baseTableName="ats_vendor_tasks" baseColumnNames="created_by_id" referencedTableName="employees" referencedColumnNames="id" constraintName="fk_ats_vendor_task_created_by"/>


        <!-- 6. ats_vendor_documents -->
        <createTable tableName="ats_vendor_documents">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="vendor_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="folder_name" type="VARCHAR(200)"/>
            <column name="file_name" type="VARCHAR(300)">
                <constraints nullable="false"/>
            </column>
            <column name="file_path" type="VARCHAR(2048)">
                <constraints nullable="false"/>
            </column>
            <column name="file_size" type="BIGINT"/>
            <column name="mime_type" type="VARCHAR(100)"/>
            <column name="comments" type="VARCHAR(2000)"/>
            <column name="uploaded_by_id" type="BIGINT"/>
            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="ats_vendor_documents" baseColumnNames="tenant_id" referencedTableName="tenants" referencedColumnNames="id" constraintName="fk_ats_vendor_doc_tenant"/>
        <addForeignKeyConstraint baseTableName="ats_vendor_documents" baseColumnNames="vendor_id" referencedTableName="ats_vendors" referencedColumnNames="id" constraintName="fk_ats_vendor_doc_vendor"/>
        <addForeignKeyConstraint baseTableName="ats_vendor_documents" baseColumnNames="uploaded_by_id" referencedTableName="employees" referencedColumnNames="id" constraintName="fk_ats_vendor_doc_uploaded_by"/>


        <!-- 7. ats_vendor_email_activities -->
        <createTable tableName="ats_vendor_email_activities">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="vendor_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="subject" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="body" type="TEXT"/>
            <column name="direction" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="from_address" type="VARCHAR(150)"/>
            <column name="to_addresses" type="VARCHAR(1000)"/>
            <column name="cc_addresses" type="VARCHAR(500)"/>
            <column name="sent_at" type="DATETIME"/>
            <column name="linked_by_id" type="BIGINT"/>
            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="ats_vendor_email_activities" baseColumnNames="tenant_id" referencedTableName="tenants" referencedColumnNames="id" constraintName="fk_ats_vendor_email_tenant"/>
        <addForeignKeyConstraint baseTableName="ats_vendor_email_activities" baseColumnNames="vendor_id" referencedTableName="ats_vendors" referencedColumnNames="id" constraintName="fk_ats_vendor_email_vendor"/>
        <addForeignKeyConstraint baseTableName="ats_vendor_email_activities" baseColumnNames="linked_by_id" referencedTableName="employees" referencedColumnNames="id" constraintName="fk_ats_vendor_email_linked_by"/>

        <!-- Foreign Key for Primary BU -->
        <addForeignKeyConstraint baseTableName="ats_vendors" baseColumnNames="primary_business_unit_id" referencedTableName="ats_business_units" referencedColumnNames="id" constraintName="fk_ats_vendor_primary_bu"/>

        <!-- 9. Accounts: ats_vendor_accounts -->
        <createTable tableName="ats_vendor_accounts">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="vendor_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="contact_person" type="VARCHAR(150)"/>
            <column name="mobile_number" type="VARCHAR(30)"/>
            <column name="office_number" type="VARCHAR(30)"/>
            <column name="office_extension" type="VARCHAR(10)"/>
            <column name="email_id" type="VARCHAR(150)"/>
            <column name="designation" type="VARCHAR(100)"/>
            <column name="payment_terms" type="VARCHAR(200)"/>
            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="ats_vendor_accounts" baseColumnNames="tenant_id" referencedTableName="tenants" referencedColumnNames="id" constraintName="fk_ats_vendor_account_tenant"/>
        <addForeignKeyConstraint baseTableName="ats_vendor_accounts" baseColumnNames="vendor_id" referencedTableName="ats_vendors" referencedColumnNames="id" constraintName="fk_ats_vendor_account_vendor"/>

        <!-- 10. Submission Format: ats_vendor_submission_formats -->
        <createTable tableName="ats_vendor_submission_formats">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="vendor_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="submission_description" type="VARCHAR(250)"/>
            <column name="mail_description" type="VARCHAR(250)"/>
            <column name="mailing_subject" type="VARCHAR(300)"/>
            <column name="body" type="TEXT"/>
            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="ats_vendor_submission_formats" baseColumnNames="tenant_id" referencedTableName="tenants" referencedColumnNames="id" constraintName="fk_ats_vendor_sub_format_tenant"/>
        <addForeignKeyConstraint baseTableName="ats_vendor_submission_formats" baseColumnNames="vendor_id" referencedTableName="ats_vendors" referencedColumnNames="id" constraintName="fk_ats_vendor_sub_format_vendor"/>

        <!-- 8. Many-To-Many Join Table: ats_vendor_business_units -->
        <createTable tableName="ats_vendor_business_units">
            <column name="vendor_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="business_unit_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="ats_vendor_business_units" columnNames="vendor_id, business_unit_id" constraintName="pk_ats_vendor_bus"/>
        <addForeignKeyConstraint baseTableName="ats_vendor_business_units" baseColumnNames="vendor_id" referencedTableName="ats_vendors" referencedColumnNames="id" constraintName="fk_ats_vbu_vendor"/>
        <addForeignKeyConstraint baseTableName="ats_vendor_business_units" baseColumnNames="business_unit_id" referencedTableName="ats_business_units" referencedColumnNames="id" constraintName="fk_ats_vbu_bu"/>

    </changeSet>
</databaseChangeLog>
