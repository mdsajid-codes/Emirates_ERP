<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="ats-vendor-documents-expansion" author="antigravity">
        <addColumn tableName="ats_vendor_documents">
            <column name="document_type_id" type="BIGINT"/>
            <column name="title" type="VARCHAR(255)"/>
        </addColumn>
        <addForeignKeyConstraint baseTableName="ats_vendor_documents" baseColumnNames="document_type_id" referencedTableName="ats_document_types" referencedColumnNames="id" constraintName="fk_ats_vendor_doc_type"/>
    </changeSet>
</databaseChangeLog>
