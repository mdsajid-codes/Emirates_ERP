<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="ats-vendor-contacts-expansion" author="antigravity">
        <addColumn tableName="ats_vendor_contacts">
            <column name="send_requirement" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="send_hotlist" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="vendor_contact_type" type="VARCHAR(100)"/>
            <column name="vendor_group" type="VARCHAR(100)"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
