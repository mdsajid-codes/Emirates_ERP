<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="add-blacklist-columns-to-entities" author="antigravity">
        <validCheckSum>ANY</validCheckSum>

        <!-- 1. ats_applicants -->
        <addColumn tableName="ats_applicants">
            <column name="blacklist_reason" type="VARCHAR(1000)"/>
            <column name="blacklisted_by" type="VARCHAR(150)"/>
            <column name="blacklisted_date" type="DATETIME"/>
        </addColumn>

        <!-- 2. ats_clients -->
        <addColumn tableName="ats_clients">
            <column name="is_blacklisted" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="blacklist_reason" type="VARCHAR(1000)"/>
            <column name="blacklisted_by" type="VARCHAR(150)"/>
            <column name="blacklisted_date" type="DATETIME"/>
        </addColumn>

        <!-- 3. ats_client_contacts -->
        <addColumn tableName="ats_client_contacts">
            <column name="is_blacklisted" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="blacklist_reason" type="VARCHAR(1000)"/>
            <column name="blacklisted_by" type="VARCHAR(150)"/>
            <column name="blacklisted_date" type="DATETIME"/>
        </addColumn>

        <!-- 4. ats_vendors -->
        <addColumn tableName="ats_vendors">
            <column name="blacklisted_by" type="VARCHAR(150)"/>
            <column name="blacklisted_date" type="DATETIME"/>
        </addColumn>

        <!-- 5. ats_vendor_contacts -->
        <addColumn tableName="ats_vendor_contacts">
            <column name="is_blacklisted" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="blacklist_reason" type="VARCHAR(1000)"/>
            <column name="blacklisted_by" type="VARCHAR(150)"/>
            <column name="blacklisted_date" type="DATETIME"/>
        </addColumn>

        <createIndex tableName="ats_applicants" indexName="idx_ats_applicant_blacklisted">
            <column name="tenant_id"/>
            <column name="is_blacklisted"/>
        </createIndex>
        <createIndex tableName="ats_clients" indexName="idx_ats_client_blacklisted">
            <column name="tenant_id"/>
            <column name="is_blacklisted"/>
        </createIndex>
        <createIndex tableName="ats_client_contacts" indexName="idx_ats_client_contact_blacklisted">
            <column name="tenant_id"/>
            <column name="is_blacklisted"/>
        </createIndex>
        <createIndex tableName="ats_vendors" indexName="idx_ats_vendor_blacklisted">
            <column name="tenant_id"/>
            <column name="is_blacklisted"/>
        </createIndex>
        <createIndex tableName="ats_vendor_contacts" indexName="idx_ats_vendor_contact_blacklisted">
            <column name="tenant_id"/>
            <column name="is_blacklisted"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
