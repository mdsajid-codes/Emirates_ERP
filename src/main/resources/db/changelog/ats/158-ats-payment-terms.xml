<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-ats-payment-terms" author="sajid">
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="ats_payment_terms"/>
            </not>
        </preConditions>
        <createTable tableName="ats_payment_terms">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(300)"/>
            <column name="days" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="ats_payment_terms" indexName="idx_ats_payment_terms_tenant">
            <column name="tenant_id"/>
        </createIndex>

        <createIndex tableName="ats_payment_terms" indexName="idx_ats_payment_terms_tenant_active">
            <column name="tenant_id"/>
            <column name="is_active"/>
        </createIndex>

        <addForeignKeyConstraint baseTableName="ats_payment_terms" baseColumnNames="tenant_id" referencedTableName="tenants" referencedColumnNames="id" constraintName="fk_ats_payment_terms_tenant"/>
    </changeSet>

    <changeSet id="add-payment-term-id-to-vendor-accounts" author="sajid">
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="ats_vendor_accounts" columnName="payment_term_id"/>
            </not>
        </preConditions>
        <addColumn tableName="ats_vendor_accounts">
            <column name="payment_term_id" type="BIGINT"/>
        </addColumn>
        <addForeignKeyConstraint baseTableName="ats_vendor_accounts" baseColumnNames="payment_term_id" referencedTableName="ats_payment_terms" referencedColumnNames="id" constraintName="fk_ats_vendor_account_payment_term"/>
    </changeSet>

</databaseChangeLog>
