<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-ats-applicant-consents-table" author="antigravity">
        <validCheckSum>ANY</validCheckSum>
        
        <createTable tableName="ats_applicant_consents">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_consent_tenant" referencedTableName="tenants" referencedColumnNames="id"/>
            </column>
            <column name="applicant_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_consent_applicant" referencedTableName="ats_applicants" referencedColumnNames="id"/>
            </column>
            <column name="consent_status" type="VARCHAR(30)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="email_sent_to" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="email_status" type="VARCHAR(30)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="consent_sent_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="responded_at" type="DATETIME"/>
            <column name="consent_token" type="VARCHAR(255)">
                <constraints unique="true"/>
            </column>
            <column name="token_expiry" type="DATETIME"/>
            <column name="rejection_reason" type="VARCHAR(1000)"/>
            <column name="sent_by_id" type="BIGINT">
                <constraints foreignKeyName="fk_consent_sent_by" referencedTableName="employees" referencedColumnNames="id"/>
            </column>
            <column name="created_at" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="ats_applicant_consents" indexName="idx_consent_tenant_status">
            <column name="tenant_id"/>
            <column name="consent_status"/>
        </createIndex>

        <createIndex tableName="ats_applicant_consents" indexName="idx_consent_applicant">
            <column name="applicant_id"/>
        </createIndex>

        <createIndex tableName="ats_applicant_consents" indexName="idx_consent_token">
            <column name="consent_token"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
