<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Config Tables -->
    <changeSet id="110-1-email" author="antigravity">
        <validCheckSum>ANY</validCheckSum>
        <createTable tableName="notif_email_configs">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_notif_email_configs"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="is_enabled" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="host" type="VARCHAR(255)"/>
            <column name="port" type="INT"/>
            <column name="username" type="VARCHAR(255)"/>
            <column name="password" type="TEXT"/>
            <column name="from_email" type="VARCHAR(255)"/>
            <column name="from_name" type="VARCHAR(255)"/>
            <column name="is_ssl_enabled" type="BOOLEAN"/>
            <column name="is_starttls_enabled" type="BOOLEAN"/>
            <column name="created_at" type="DATETIME"/>
            <column name="updated_at" type="DATETIME"/>
        </createTable>
    </changeSet>

    <changeSet id="110-1-sms" author="antigravity">
        <validCheckSum>ANY</validCheckSum>
        <createTable tableName="notif_sms_configs">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_notif_sms_configs"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="is_enabled" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="provider" type="VARCHAR(50)"/>
            <column name="api_key" type="TEXT"/>
            <column name="api_secret" type="TEXT"/>
            <column name="sender_id" type="VARCHAR(20)"/>
            <column name="created_at" type="DATETIME"/>
            <column name="updated_at" type="DATETIME"/>
        </createTable>
    </changeSet>

    <changeSet id="110-1-whatsapp" author="antigravity">
        <validCheckSum>ANY</validCheckSum>
        <createTable tableName="notif_whatsapp_configs">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_notif_whatsapp_configs"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="is_enabled" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="provider" type="VARCHAR(50)"/>
            <column name="api_key" type="TEXT"/>
            <column name="phone_number_id" type="VARCHAR(100)"/>
            <column name="waba_id" type="VARCHAR(100)"/>
            <column name="created_at" type="DATETIME"/>
            <column name="updated_at" type="DATETIME"/>
        </createTable>
    </changeSet>

    <changeSet id="110-1-telegram" author="antigravity">
        <validCheckSum>ANY</validCheckSum>
        <createTable tableName="notif_telegram_configs">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_notif_telegram_configs"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="is_enabled" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="bot_token" type="TEXT"/>
            <column name="default_chat_id" type="VARCHAR(100)"/>
            <column name="created_at" type="DATETIME"/>
            <column name="updated_at" type="DATETIME"/>
        </createTable>
    </changeSet>

    <!-- Template Tables -->
    <changeSet id="110-2-email-template" author="antigravity">
        <validCheckSum>ANY</validCheckSum>
        <createTable tableName="notif_email_templates">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_notif_email_templates"/>
            </column>
            <column name="tenant_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="template_id" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="name" type="VARCHAR(150)"><constraints nullable="false"/></column>
            <column name="subject" type="VARCHAR(300)"/>
            <column name="body" type="TEXT"><constraints nullable="false"/></column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="language_code" type="VARCHAR(10)" defaultValue="en"/>
            <column name="created_at" type="DATETIME"/>
            <column name="updated_at" type="DATETIME"/>
        </createTable>
        <addUniqueConstraint tableName="notif_email_templates" columnNames="tenant_id, template_id" constraintName="uk_notif_email_temp_tid"/>
    </changeSet>

    <changeSet id="110-2-sms-template" author="antigravity">
        <validCheckSum>ANY</validCheckSum>
        <createTable tableName="notif_sms_templates">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_notif_sms_templates"/>
            </column>
            <column name="tenant_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="template_id" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="name" type="VARCHAR(150)"/>
            <column name="body" type="TEXT"><constraints nullable="false"/></column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="created_at" type="DATETIME"/>
        </createTable>
        <addUniqueConstraint tableName="notif_sms_templates" columnNames="tenant_id, template_id" constraintName="uk_notif_sms_temp_tid"/>
    </changeSet>

    <changeSet id="110-2-whatsapp-template" author="antigravity">
        <validCheckSum>ANY</validCheckSum>
        <createTable tableName="notif_whatsapp_templates">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_notif_whatsapp_templates"/>
            </column>
            <column name="tenant_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="template_id" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="name" type="VARCHAR(150)"/>
            <column name="whatsapp_template_id" type="VARCHAR(120)"/>
            <column name="body" type="TEXT"/>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="created_at" type="DATETIME"/>
        </createTable>
        <addUniqueConstraint tableName="notif_whatsapp_templates" columnNames="tenant_id, template_id" constraintName="uk_notif_wa_temp_tid"/>
    </changeSet>

    <!-- Log Tables -->
    <changeSet id="110-3-email-log-v2" author="antigravity">
        <validCheckSum>ANY</validCheckSum>
        <createTable tableName="notif_email_logs">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_notif_email_logs"/>
            </column>
            <column name="tenant_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="recipient" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="subject" type="VARCHAR(300)"/>
            <column name="body" type="TEXT"/>
            <column name="template_id" type="VARCHAR(100)"/>
            <column name="status" type="VARCHAR(30)"><constraints nullable="false"/></column>
            <column name="error_message" type="TEXT"/>
            <column name="sent_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <changeSet id="110-3-sms-log-v2" author="antigravity">
        <validCheckSum>ANY</validCheckSum>
        <createTable tableName="notif_sms_logs">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_notif_sms_logs"/>
            </column>
            <column name="tenant_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="recipient" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="body" type="TEXT"/>
            <column name="template_id" type="VARCHAR(100)"/>
            <column name="status" type="VARCHAR(30)"><constraints nullable="false"/></column>
            <column name="error_message" type="TEXT"/>
            <column name="provider_message_id" type="VARCHAR(255)"/>
            <column name="sent_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <changeSet id="110-3-whatsapp-log-v2" author="antigravity">
        <validCheckSum>ANY</validCheckSum>
        <createTable tableName="notif_whatsapp_logs">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_notif_whatsapp_logs"/>
            </column>
            <column name="tenant_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="recipient" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="body" type="TEXT"/>
            <column name="template_id" type="VARCHAR(100)"/>
            <column name="status" type="VARCHAR(30)"><constraints nullable="false"/></column>
            <column name="error_message" type="TEXT"/>
            <column name="provider_message_id" type="VARCHAR(255)"/>
            <column name="sent_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!-- In-App Messages -->
    <changeSet id="110-4-v2" author="antigravity">
        <validCheckSum>ANY</validCheckSum>
        <createTable tableName="notif_in_app_messages">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_notif_in_app_messages"/>
            </column>
            <column name="tenant_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="recipient_user_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="title" type="VARCHAR(200)"><constraints nullable="false"/></column>
            <column name="body" type="TEXT"><constraints nullable="false"/></column>
            <column name="icon" type="VARCHAR(50)"/>
            <column name="action_url" type="VARCHAR(500)"/>
            <column name="reference_type" type="VARCHAR(60)"/>
            <column name="reference_id" type="BIGINT"/>
            <column name="status" type="VARCHAR(30)"><constraints nullable="false"/></column>
            <column name="is_archived" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="read_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!-- Subscriptions -->
    <changeSet id="110-5-v2" author="antigravity">
        <validCheckSum>ANY</validCheckSum>
        <createTable tableName="notif_subscriptions">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_notif_subscriptions"/>
            </column>
            <column name="tenant_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="user_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="channel" type="VARCHAR(30)"><constraints nullable="false"/></column>
            <column name="is_subscribed" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="push_token" type="VARCHAR(500)"/>
            <column name="updated_at" type="DATETIME"/>
        </createTable>
        <addUniqueConstraint tableName="notif_subscriptions" columnNames="tenant_id, user_id, channel" constraintName="uk_notif_sub_v2"/>
    </changeSet>

    <!-- Webhooks -->
    <changeSet id="110-6-v2" author="antigravity">
        <validCheckSum>ANY</validCheckSum>
        <createTable tableName="notif_webhook_endpoints">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_notif_webhook_endpoints"/>
            </column>
            <column name="tenant_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="name" type="VARCHAR(150)"><constraints nullable="false"/></column>
            <column name="url" type="VARCHAR(1000)"><constraints nullable="false"/></column>
            <column name="template_id" type="VARCHAR(100)"/>
            <column name="secret" type="TEXT"/>
            <column name="http_method" type="VARCHAR(10)" defaultValue="POST"/>
            <column name="custom_headers" type="TEXT"/>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="last_triggered_at" type="TIMESTAMP"/>
            <column name="last_status_code" type="INT"/>
            <column name="created_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
