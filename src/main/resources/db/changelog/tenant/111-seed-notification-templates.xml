<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="111-seed-welcome-email" author="antigravity">
        <validCheckSum>ANY</validCheckSum>
        <insert tableName="notif_email_templates">
            <column name="tenant_id" valueNumeric="1"/>
            <column name="template_id" value="welcome_email"/>
            <column name="name" value="Welcome Email"/>
            <column name="subject" value="Welcome to Our Platform!"/>
            <column name="body" value="Hello {{name}}, welcome to our platform! We are glad to have you."/>
            <column name="is_active" valueBoolean="true"/>
            <column name="created_at" valueComputed="now()"/>
        </insert>
    </changeSet>

    <changeSet id="111-seed-otp-email" author="antigravity">
        <validCheckSum>ANY</validCheckSum>
        <insert tableName="notif_email_templates">
            <column name="tenant_id" valueNumeric="1"/>
            <column name="template_id" value="otp_email"/>
            <column name="name" value="OTP Verification"/>
            <column name="subject" value="Your OTP Code"/>
            <column name="body" value="Hello, your one-time password is {{otp}}. It will expire in 10 minutes."/>
            <column name="is_active" valueBoolean="true"/>
            <column name="created_at" valueComputed="now()"/>
        </insert>
    </changeSet>

</databaseChangeLog>
