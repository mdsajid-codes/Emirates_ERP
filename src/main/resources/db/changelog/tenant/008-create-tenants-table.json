{
    "databaseChangeLog": [
        {
            "changeSet": {
                "id": "008-create-tenants-table",
                "author": "sajid",
                "preConditions": [
                    {
                        "onFail": "MARK_RAN",
                        "not": {
                            "tableExists": {
                                "tableName": "tenants"
                            }
                        }
                    }
                ],
                "changes": [
                    {
                        "createTable": {
                            "tableName": "tenants",
                            "columns": [
                                {
                                    "column": {
                                        "name": "id",
                                        "type": "BIGINT",
                                        "autoIncrement": true,
                                        "constraints": {
                                            "primaryKey": true,
                                            "nullable": false
                                        }
                                    }
                                },
                                {
                                    "column": {
                                        "name": "tenant_id",
                                        "type": "VARCHAR(255)",
                                        "constraints": {
                                            "nullable": false,
                                            "unique": true
                                        }
                                    }
                                },
                                {
                                    "column": {
                                        "name": "name",
                                        "type": "VARCHAR(255)",
                                        "constraints": {
                                            "nullable": false
                                        }
                                    }
                                },
                                {
                                    "column": {
                                        "name": "logo_img_url",
                                        "type": "VARCHAR(255)"
                                    }
                                },
                                {
                                    "column": {
                                        "name": "contact_email",
                                        "type": "VARCHAR(255)"
                                    }
                                },
                                {
                                    "column": {
                                        "name": "contact_phone",
                                        "type": "VARCHAR(255)"
                                    }
                                },
                                {
                                    "column": {
                                        "name": "address",
                                        "type": "VARCHAR(255)"
                                    }
                                },
                                {
                                    "column": {
                                        "name": "smtp_host",
                                        "type": "VARCHAR(255)"
                                    }
                                },
                                {
                                    "column": {
                                        "name": "smtp_port",
                                        "type": "INT"
                                    }
                                },
                                {
                                    "column": {
                                        "name": "smtp_username",
                                        "type": "VARCHAR(255)"
                                    }
                                },
                                {
                                    "column": {
                                        "name": "smtp_password",
                                        "type": "VARCHAR(255)"
                                    }
                                },
                                {
                                    "column": {
                                        "name": "company_email",
                                        "type": "VARCHAR(255)"
                                    }
                                },
                                {
                                    "column": {
                                        "name": "created_at",
                                        "type": "datetime"
                                    }
                                }
                            ]
                        }
                    }
                ]
            }
        }
    ]
}