<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="114-seed-crm-reminder-email" author="antigravity">
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="notif_email_templates"/>
        </preConditions>
        <insert tableName="notif_email_templates">
            <column name="tenant_id" valueNumeric="1"/>
            <column name="template_id" value="crm_reminder_alert"/>
            <column name="name" value="CRM Reminder Email"/>
            <column name="subject" value="Reminder: {{title}}"/>
            <column name="body" value="Hello, this is a reminder for your scheduled engagement: {{title}} at {{time}} on {{date}}. Description: {{description}}. — CRM Strategic Alert"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="created_at" valueComputed="now()"/>
        </insert>
    </changeSet>

    <changeSet id="114-seed-crm-reminder-sms" author="antigravity">
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="notif_sms_templates"/>
        </preConditions>
        <insert tableName="notif_sms_templates">
            <column name="tenant_id" valueNumeric="1"/>
            <column name="template_id" value="crm_reminder_alert"/>
            <column name="name" value="CRM Reminder SMS"/>
            <column name="body" value="CRM Alert: {{title}} is scheduled for {{time}} today. Stay strategic!"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="created_at" valueComputed="now()"/>
        </insert>
    </changeSet>

    <changeSet id="114-seed-crm-reminder-whatsapp" author="antigravity">
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="notif_whatsapp_templates"/>
        </preConditions>
        <insert tableName="notif_whatsapp_templates">
            <column name="tenant_id" valueNumeric="1"/>
            <column name="template_id" value="crm_reminder_alert"/>
            <column name="name" value="CRM Reminder WhatsApp"/>
            <column name="whatsapp_template_id" value="crm_reminder_alert"/>
            <column name="body" value="Reminder: {{title}} is scheduled for {{date}} at {{time}}. — CRM Strategic Alert"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="created_at" valueComputed="now()"/>
        </insert>
    </changeSet>

</databaseChangeLog>
