<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <changeSet id="hng-qc-log-v1" author="antigravity">
        <validCheckSum>ANY</validCheckSum>
        
        <!-- Create QC Inspection Log table -->
        <createTable tableName="hng_qc_log">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_hng_qc_tenant" referencedTableName="tenants" referencedColumnNames="id"/>
            </column>
            <column name="batch_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_hng_qc_batch" referencedTableName="hng_production_batch" referencedColumnNames="id"/>
            </column>
            <column name="qc_log_no" type="VARCHAR(50)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_hng_qc_log_no"/>
            </column>
            <column name="inspector_id" type="BIGINT">
                <constraints foreignKeyName="fk_hng_qc_inspector" referencedTableName="employees" referencedColumnNames="id"/>
            </column>
            <column name="sample_size" type="INT"/>
            <column name="inspected_qty" type="INT"/>
            <column name="passed_qty" type="INT"/>
            <column name="rejected_qty" type="INT"/>
            <column name="rework_qty" type="INT"/>
            <column name="defect_type" type="VARCHAR(100)"/>
            <column name="qc_result" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="defect_pct" type="DECIMAL(5,2)"/>
            <column name="load_test_passed" type="BOOLEAN"/>
            <column name="remarks" type="TEXT"/>
            <column name="created_at" type="datetime" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <createIndex tableName="hng_qc_log" indexName="idx_hng_qc_batch">
            <column name="tenant_id"/>
            <column name="batch_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="hng-scrap-entry-qc-log-link-v1" author="antigravity">
        <validCheckSum>ANY</validCheckSum>
        <addColumn tableName="hng_scrap_entry">
            <column name="qc_log_id" type="BIGINT">
                <constraints foreignKeyName="fk_hng_scrap_qc" referencedTableName="hng_qc_log" referencedColumnNames="id"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
