<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <changeSet id="hng-job-card-v1" author="antigravity">
        <validCheckSum>ANY</validCheckSum>
        <!-- Add Standard Cycle Time and Tolerances to Hanger Types -->
        <addColumn tableName="hng_hanger_types">
            <column name="standard_cycle_time_sec" type="decimal(8,2)" defaultValueNumeric="2.50">
                <constraints nullable="false"/>
            </column>
            <column name="shoulder_width_tolerance_mm" type="decimal(6,2)" defaultValueNumeric="2.00">
                <constraints nullable="false"/>
            </column>
            <column name="hook_size_tolerance_mm" type="decimal(6,2)" defaultValueNumeric="1.00">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <!-- Create Job Card table for Bending / Forming stage -->
        <createTable tableName="hng_job_card">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_hng_jc_tenant" referencedTableName="tenants" referencedColumnNames="id"/>
            </column>
            <column name="batch_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_hng_jc_batch" referencedTableName="hng_production_batch" referencedColumnNames="id"/>
            </column>
            <column name="job_card_no" type="VARCHAR(50)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_hng_job_card_no"/>
            </column>
            <column name="workstation_id" type="BIGINT">
                <constraints foreignKeyName="fk_hng_jc_ws" referencedTableName="pro_work_stations" referencedColumnNames="id"/>
            </column>
            <column name="tool_die_no" type="VARCHAR(100)"/>
            <column name="operator_id" type="BIGINT">
                <constraints foreignKeyName="fk_hng_jc_operator" referencedTableName="employees" referencedColumnNames="id"/>
            </column>
            <column name="shift" type="varchar(20)"/>
            <column name="planned_qty" type="INT"/>
            <column name="target_qty" type="INT"/>
            <column name="produced_qty" type="INT"/>
            <column name="rejected_qty" type="INT"/>
            <column name="rework_qty" type="INT"/>
            <column name="labor_hours" type="decimal(6,2)"/>
            <column name="workstation_run_hours" type="decimal(6,2)"/>
            <column name="breakdown_time" type="decimal(6,2)"/>
            <column name="cycle_time_sec" type="decimal(8,2)"/>
            <column name="availability_pct" type="decimal(5,2)"/>
            <column name="performance_pct" type="decimal(5,2)"/>
            <column name="quality_pct" type="decimal(5,2)"/>
            <column name="oee_pct" type="decimal(5,2)"/>
            <column name="actual_shoulder_width_mm" type="decimal(6,2)"/>
            <column name="actual_hook_size_mm" type="decimal(6,2)"/>
            <column name="dimension_pass" type="BOOLEAN"/>
            <column name="start_time" type="datetime"/>
            <column name="end_time" type="datetime"/>
            <column name="remarks" type="TEXT"/>
            <column name="created_at" type="datetime" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <createIndex tableName="hng_job_card" indexName="idx_hng_jc_batch">
            <column name="tenant_id"/>
            <column name="batch_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
