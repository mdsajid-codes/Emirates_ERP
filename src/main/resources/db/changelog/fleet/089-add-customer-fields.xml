<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <changeSet id="089-add-customer-fields" author="antigravity">
        <validCheckSum>ANY</validCheckSum>
        <addColumn tableName="trip_customers">
            <column name="trade_license_number" type="VARCHAR(100)"/>
            <column name="contact_person_name" type="VARCHAR(255)"/>
            <column name="designation" type="VARCHAR(100)"/>
            <column name="status" type="VARCHAR(50)"/>
            <column name="emirate" type="VARCHAR(100)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
