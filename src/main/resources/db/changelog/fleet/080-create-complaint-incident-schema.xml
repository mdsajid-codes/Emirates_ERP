<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

    <changeSet id="create-complaint-incident-table" author="system">
        <validCheckSum>ANY</validCheckSum>
        <createTable tableName="fleet_complaints">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_complaint_tenant" referencedTableName="tenants" referencedColumnNames="id"/>
            </column>
            <column name="reported_date" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="reported_by_type" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="reported_by_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="category" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="trip_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_complaint_trip" referencedTableName="trips" referencedColumnNames="id"/>
            </column>
            <column name="vehicle_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_complaint_vehicle" referencedTableName="fleet_vehicles" referencedColumnNames="id"/>
            </column>
            <column name="driver_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_complaint_driver" referencedTableName="fleet_drivers" referencedColumnNames="id"/>
            </column>
            <column name="description" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="risk_level" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="assigned_to" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_complaint_user" referencedTableName="users" referencedColumnNames="id"/>
            </column>
            <column name="resolution_notes" type="TEXT"/>
            <column name="attachment_path" type="VARCHAR(255)"/>
            <column name="created_at" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="datetime">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
