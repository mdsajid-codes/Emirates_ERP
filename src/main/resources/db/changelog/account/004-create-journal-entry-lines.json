                {"column": {"name": "dim_bank_account_id", "type": "BIGINT"}},
                {"column": {"name": "dim_tax_type_id", "type": "BIGINT"}},
                {"column": {"name": "dim_cash_flow_item_id", "type": "BIGINT"}}
              ]
