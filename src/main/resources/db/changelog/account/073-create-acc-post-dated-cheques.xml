<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="073-create-acc-post-dated-cheques" author="system">
        <createTable tableName="acc_post_dated_cheques">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="pdc_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="cheque_number" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="cheque_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(18,2)">
                <constraints nullable="false"/>
            </column>
            <column name="currency_id" type="BIGINT"/>
            <column name="bank_name" type="VARCHAR(200)"/>
            <column name="bank_account_id" type="BIGINT"/>
            <column name="partner_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="partner_type" type="VARCHAR(50)"/>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="payment_id" type="BIGINT"/>
            <column name="step1_journal_entry_id" type="BIGINT"/>
            <column name="step2_journal_entry_id" type="BIGINT"/>
            <column name="bank_charges" type="DECIMAL(10,2)" defaultValueNumeric="0.00"/>
            <column name="notes" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="cleared_at" type="TIMESTAMP"/>
            <column name="tenant_id" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
