<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="017-drop-company-gl-accounts" author="dev-a">
    <preConditions onFail="MARK_RAN">
      <tableExists tableName="company_gl_accounts"/>
    </preConditions>
    <dropTable tableName="company_gl_accounts"/>
  </changeSet>

  <changeSet id="017-create-party-gl-accounts" author="dev-a">
    <preConditions onFail="MARK_RAN">
      <not>
        <tableExists tableName="party_gl_accounts"/>
      </not>
    </preConditions>
    <createTable tableName="party_gl_accounts">
      <column name="party_gl_account_id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="party_type" type="VARCHAR(20)">
        <constraints nullable="false"/>
      </column>
      <column name="party_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="accounts_receivable_id" type="BIGINT"/>
      <column name="accounts_payable_id" type="BIGINT"/>
      <column name="advances_received_id" type="BIGINT"/>
      <column name="advances_paid_id" type="BIGINT"/>
      <column name="pdcs_received_id" type="BIGINT"/>
      <column name="pdcs_issued_id" type="BIGINT"/>
      <column name="contract_assets_id" type="BIGINT"/>
      <column name="retention_receivables_id" type="BIGINT"/>
      <column name="retention_payables_id" type="BIGINT"/>
      <column name="retention_output_vat_id" type="BIGINT"/>
      <column name="retention_input_vat_id" type="BIGINT"/>
      <column name="unbilled_purchases_id" type="BIGINT"/>
      <column name="advance_to_receive_id" type="BIGINT"/>
      <column name="tenant_id" type="BIGINT"/>
      <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
      <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
    </createTable>

    <!-- Foreign Keys for GL accounts -->
    <addForeignKeyConstraint baseTableName="party_gl_accounts" baseColumnNames="accounts_receivable_id" referencedTableName="chart_of_accounts" referencedColumnNames="account_id" constraintName="fk_party_gl_ar"/>
    <addForeignKeyConstraint baseTableName="party_gl_accounts" baseColumnNames="accounts_payable_id" referencedTableName="chart_of_accounts" referencedColumnNames="account_id" constraintName="fk_party_gl_ap"/>
    <addForeignKeyConstraint baseTableName="party_gl_accounts" baseColumnNames="advances_received_id" referencedTableName="chart_of_accounts" referencedColumnNames="account_id" constraintName="fk_party_gl_adv_rec"/>
    <addForeignKeyConstraint baseTableName="party_gl_accounts" baseColumnNames="advances_paid_id" referencedTableName="chart_of_accounts" referencedColumnNames="account_id" constraintName="fk_party_gl_adv_paid"/>
    <addForeignKeyConstraint baseTableName="party_gl_accounts" baseColumnNames="pdcs_received_id" referencedTableName="chart_of_accounts" referencedColumnNames="account_id" constraintName="fk_party_gl_pdcs_rec"/>
    <addForeignKeyConstraint baseTableName="party_gl_accounts" baseColumnNames="pdcs_issued_id" referencedTableName="chart_of_accounts" referencedColumnNames="account_id" constraintName="fk_party_gl_pdcs_iss"/>
    <addForeignKeyConstraint baseTableName="party_gl_accounts" baseColumnNames="contract_assets_id" referencedTableName="chart_of_accounts" referencedColumnNames="account_id" constraintName="fk_party_gl_cont_asset"/>
    <addForeignKeyConstraint baseTableName="party_gl_accounts" baseColumnNames="retention_receivables_id" referencedTableName="chart_of_accounts" referencedColumnNames="account_id" constraintName="fk_party_gl_ret_rec"/>
    <addForeignKeyConstraint baseTableName="party_gl_accounts" baseColumnNames="retention_payables_id" referencedTableName="chart_of_accounts" referencedColumnNames="account_id" constraintName="fk_party_gl_ret_pay"/>
    <addForeignKeyConstraint baseTableName="party_gl_accounts" baseColumnNames="retention_output_vat_id" referencedTableName="chart_of_accounts" referencedColumnNames="account_id" constraintName="fk_party_gl_ret_o_vat"/>
    <addForeignKeyConstraint baseTableName="party_gl_accounts" baseColumnNames="retention_input_vat_id" referencedTableName="chart_of_accounts" referencedColumnNames="account_id" constraintName="fk_party_gl_ret_i_vat"/>
    <addForeignKeyConstraint baseTableName="party_gl_accounts" baseColumnNames="unbilled_purchases_id" referencedTableName="chart_of_accounts" referencedColumnNames="account_id" constraintName="fk_party_gl_unbilled_pur"/>
    <addForeignKeyConstraint baseTableName="party_gl_accounts" baseColumnNames="advance_to_receive_id" referencedTableName="chart_of_accounts" referencedColumnNames="account_id" constraintName="fk_party_gl_adv_to_rec"/>

    <!-- Tenant Foreign Key -->
    <addForeignKeyConstraint baseTableName="party_gl_accounts" baseColumnNames="tenant_id" referencedTableName="tenants" referencedColumnNames="id" constraintName="fk_party_gl_tenant"/>

    <!-- Unique Constraint per Tenant, Party Type and Party ID -->
    <addUniqueConstraint tableName="party_gl_accounts" columnNames="tenant_id, party_type, party_id" constraintName="uq_party_gl_tenant_type_id"/>
  </changeSet>

</databaseChangeLog>
