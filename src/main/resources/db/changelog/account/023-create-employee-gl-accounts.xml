<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="023-create-employee-gl-accounts" author="antigravity">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="chart_of_accounts"/>
            <tableExists tableName="tenants"/>
        </preConditions>
        <createTable tableName="employee_gl_accounts">
            <column name="employee_gl_account_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="employee_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="salary_payable_account_id" type="BIGINT"/>
            <column name="advance_account_id" type="BIGINT"/>
            <column name="expense_account_id" type="BIGINT"/>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="employee_gl_accounts" baseColumnNames="salary_payable_account_id"
                                 constraintName="fk_emp_gl_salary_payable"
                                 referencedTableName="chart_of_accounts" referencedColumnNames="account_id"/>
                                 
        <addForeignKeyConstraint baseTableName="employee_gl_accounts" baseColumnNames="advance_account_id"
                                 constraintName="fk_emp_gl_advance"
                                 referencedTableName="chart_of_accounts" referencedColumnNames="account_id"/>
                                 
        <addForeignKeyConstraint baseTableName="employee_gl_accounts" baseColumnNames="expense_account_id"
                                 constraintName="fk_emp_gl_expense"
                                 referencedTableName="chart_of_accounts" referencedColumnNames="account_id"/>
                                 
        <addForeignKeyConstraint baseTableName="employee_gl_accounts" baseColumnNames="tenant_id"
                                 constraintName="fk_emp_gl_tenant"
                                 referencedTableName="tenants" referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>
