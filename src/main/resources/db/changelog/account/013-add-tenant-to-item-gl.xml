<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="013-add-tenant-to-item-gl" author="dev-a">
    <preConditions onFail="MARK_RAN">
      <not>
        <columnExists tableName="item_gl_accounts" columnName="tenant_id"/>
      </not>
    </preConditions>
    <addColumn tableName="item_gl_accounts">
      <column name="tenant_id" type="BIGINT"/>
    </addColumn>
    <addForeignKeyConstraint baseTableName="item_gl_accounts"
                             baseColumnNames="tenant_id"
                             referencedTableName="tenants"
                             referencedColumnNames="id"
                             constraintName="fk_item_gl_tenant"/>
  </changeSet>

</databaseChangeLog>
